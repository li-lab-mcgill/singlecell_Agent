GENESET_MEMBERSHIP_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "geneset_membership.npz")
GENESET_MEMBERSHIP_TFIDF_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "geneset_membership_tfidf.npz")
GENESET_METADATA_CSV = os.path.join(PRIOR_OUTPUT_DIR, "geneset_metadata.csv")
GENE_GRAPH_EDGES_CSV = os.path.join(PRIOR_OUTPUT_DIR, "gene_graph_edges.csv")
