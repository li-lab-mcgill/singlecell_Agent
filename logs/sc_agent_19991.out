# Diagnostics
GENE_SET_FREQ_CSV = os.path.join(PRIOR_OUTPUT_DIR, "gene_set_frequency.csv")
COVERAGE_STATS_JSON = os.path.join(PRIOR_OUTPUT_DIR, "coverage_stats.json")
PRUNED_GENES_CSV = os.path.join(PRIOR_OUTPUT_DIR, "pruned_genes_blacklist.csv")

# Source priority (lower is preferred)
SOURCE_PRIORITY = {"MSigDB": 1, "GO": 2, "NeST": 3}

# Basic thresholds
DETECT_FRAC_THRESH = 0.01  # 1% detection threshold
SET_SIZE_MIN = 10
SET_SIZE_MAX = 300
UBIQUITY_PRUNE_Q = 0.90  # top 10% most ubiquitous genes


def ensure_dir(path: str):
    os.makedirs(path, exist_ok=True)


def load_meta_info(meta_path: str) -> Tuple[Dict[str, str], Set[str], Set[str], Set[str]]:
    df = pd.read_csv(meta_path)
    # Normalize columns
    for col in ["gene", "species", "summary_symbol", "summary_type"]:
        if col not in df.columns:
            df[col] = np.nan
    df["__gene_upper"] = df["gene"].astype(str).str.upper().str.strip()
    df["__symb_upper"] = df["summary_symbol"].astype(str).str.upper().str.strip()
    df["__species_lower"] = df["species"].astype(str).str.lower().str.strip()
    df["__type_upper"] = df["summary_type"].astype(str).str.upper()

    # Human-only mapping
    human_mask = df["__species_lower"].str.contains("human") | df["__species_lower"].str.contains("homo sapiens")
    df_human = df[human_mask].copy()

    # Build mapping from various gene names/synonyms to canonical summary_symbol
    mapping: Dict[str, str] = {}
    df_human_valid = df_human[df_human["__symb_upper"].str.len() > 0].copy()
    for g, s in zip(df_human_valid["__gene_upper"].values, df_human_valid["__symb_upper"].values):
        if isinstance(g, str) and len(g) > 0 and isinstance(s, str) and len(s) > 0:
            mapping[g] = s
    # Also map summary_symbol to itself
    for s in df_human_valid["__symb_upper"].unique():
        mapping[s] = s

    # Pseudogene flags (by canonical symbol)
    pseudo_mask = df_human["__type_upper"].str.contains("PSEUDOGENE", na=False)
    pseudogene_symbols = set(df_human.loc[pseudo_mask, "__symb_upper"].dropna().tolist())

    # rRNA flags
    rrna_mask = df_human["__type_upper"].str.contains("RIBOSOMAL RNA", na=False) | df_human["__type_upper"].str.contains("RRNA", na=False)
    rrna_symbols = set(df_human.loc[rrna_mask, "__symb_upper"].dropna().tolist())

    # All known human canonical symbols
    all_human_symbols = set(df_human_valid["__symb_upper"].unique().tolist())
    return mapping, pseudogene_symbols, all_human_symbols, rrna_symbols


def normalize_gene_symbol(sym: str) -> str:
    s = str(sym).upper().strip()
    s = re.sub(r"\s+", "", s)
    # Strip transcript/isoform version suffixes like .1, .2 etc
    s = re.sub(r"\.\d+$", "", s)
    return s


def map_and_merge_symbols(symbols: List[str], mapping: Dict[str, str]) -> List[str]:
    seen = set()
    out = []
    for g in symbols:
        gu = normalize_gene_symbol(g)
        canon = mapping.get(gu, gu)
        if canon not in seen and len(canon) > 0:
            seen.add(canon)
            out.append(canon)
    return out


def parse_gene_list(raw: str) -> List[str]:
    if pd.isna(raw):
        return []
    toks = re.split(r"[,\s;]+", str(raw))
    toks = [normalize_gene_symbol(t) for t in toks if len(t) > 0]
    return toks


def read_adata(path: str) -> ad.AnnData:
    return ad.read_h5ad(path)


def get_counts_matrix(adata: ad.AnnData):
    if "counts" in adata.layers:
        X = adata.layers["counts"]
    else:
        X = adata.X
    return X


def load_dataset_genes_and_detection(h5ad_primary: str,
                                     h5ad_fallback: str,
                                     mapping: Dict[str, str],
                                     detect_thresh: float = DETECT_FRAC_THRESH) -> Tuple[List[str], Dict[str, float]]:
    # Prefer preprocessed training features if available
    if os.path.exists(h5ad_primary):
        adata = read_adata(h5ad_primary)
    else:
        adata = read_adata(h5ad_fallback)
    X = get_counts_matrix(adata)
    n_cells = adata.n_obs
    var_names = list(map(str, adata.var_names.tolist()))
    normed = [normalize_gene_symbol(g) for g in var_names]
    # Compute detection fraction per raw gene index
    if sp.issparse(X):
        det_counts = np.array((X > 0).sum(axis=0)).ravel()
    else:
        det_counts = (np.array(X) > 0).sum(axis=0)
    det_frac_raw = det_counts / max(1, n_cells)
    # Map to canonical symbols, merge duplicates by max detection
    canon_to_det: Dict[str, float] = {}
    for g, f in zip(normed, det_frac_raw):
        c = mapping.get(g, g)
        prev = canon_to_det.get(c, 0.0)
        if f > prev:
            canon_to_det[c] = float(f)
    # Keep expressed genes
    genes = [g for g, f in canon_to_det.items() if f >= detect_thresh]
    genes = sorted(genes)
    return genes, canon_to_det


def parse_msigdb(path: str, mapping: Dict[str, str]) -> List[Dict]:
    df = pd.read_csv(path)
    cols = df.columns
    id_col = "ID" if "ID" in cols else cols[0]
    name_col = "Name" if "Name" in cols else cols[1]
    genes_col = "Genes"
    out = []
    for _, row in df.iterrows():
        gid = str(row[id_col])
        name = str(row[name_col])
        genes = parse_gene_list(row.get(genes_col, ""))
        genes = map_and_merge_symbols(genes, mapping)
        if len(genes) == 0:
            continue
        out.append({"id": gid, "name": name, "source": "MSigDB", "genes": genes, "orig_size": len(genes)})
    return out


def parse_go_terms(path: str, mapping: Dict[str, str]) -> List[Dict]:
    df = pd.read_csv(path)
    id_col = "GO" if "GO" in df.columns else "ID"
    name_col = "Term_Description" if "Term_Description" in df.columns else "Name"
    genes_col = "Genes"
    out = []
    for _, row in df.iterrows():
        gid = str(row[id_col])
        name = str(row[name_col]) if name_col in row else gid
        genes = parse_gene_list(row.get(genes_col, ""))
        genes = map_and_merge_symbols(genes, mapping)
        if len(genes) == 0:
            continue
        out.append({"id": gid, "name": name, "source": "GO", "genes": genes, "orig_size": len(genes)})
    return out


def parse_nest(path: str, mapping: Dict[str, str]) -> List[Dict]:
    df = pd.read_csv(path, sep="\t")
    id_col = "NEST ID" if "NEST ID" in df.columns else "ID"
    name_col = "name_new" if "name_new" in df.columns else "Name"
    genes_col = "Genes"
    out = []
    for _, row in df.iterrows():
        gid = str(row[id_col])
        name = str(row[name_col]) if name_col in row else gid
        genes = parse_gene_list(row.get(genes_col, ""))
        genes = map_and_merge_symbols(genes, mapping)
        if len(genes) == 0:
            continue
        out.append({"id": gid, "name": name, "source": "NeST", "genes": genes, "orig_size": len(genes)})
    return out


def is_generic_go_name(name: str) -> bool:
    n = name.lower()
    patterns = ["regulation of", "process", "metabolic process", "biological process", "cellular process", "response to"]
    return any(p in n for p in patterns)


def curate_gene_sets(gene_sets: List[Dict],
                     dataset_genes: Set[str],
                     detection_frac: Dict[str, float],
                     marker_genes: Set[str],
                     low_value_blacklist: Set[str]) -> Tuple[List[Dict], Set[str]]:
    pruned_blacklist: Set[str] = set()
    curated = []
    for gs in gene_sets:
        genes = [g for g in gs["genes"] if g in dataset_genes]
        # Prune low-value genes unless marker
        filtered = []
        for g in genes:
            if g in marker_genes:
                filtered.append(g)
                continue
            if (g in low_value_blacklist) or (detection_frac.get(g, 0.0) < DETECT_FRAC_THRESH):
                pruned_blacklist.add(g)
                continue
            filtered.append(g)
        genes = sorted(set(filtered))
        if len(genes) < SET_SIZE_MIN or len(genes) > SET_SIZE_MAX:
            continue
        retained_frac = len(genes) / max(1, gs.get("orig_size", len(genes)))
        if retained_frac < 0.5:
            continue
        # GO generic terms: drop if still broad
        if gs["source"] == "GO" and is_generic_go_name(gs["name"]) and len(genes) > 100:
            continue
        median_det = float(np.median([detection_frac.get(g, 0.0) for g in genes])) if genes else 0.0
        if median_det < DETECT_FRAC_THRESH:
            continue
        item = dict(gs)
        item["genes"] = genes
        item["size"] = len(genes)
        item["retained_fraction"] = float(retained_frac)
        item["median_detection"] = median_det
        curated.append(item)

    # Greedy de-duplication with refined priority
    def priority_key(x: Dict) -> Tuple[int, int, int, str]:
        base = SOURCE_PRIORITY.get(x["source"], 999)
        # Favor MSigDB Hallmark-like sets
        hall = 0
        if x["source"] == "MSigDB" and "HALLMARK" in str(x["name"]).upper():
            hall = -1
        # Penalize generic GO
        go_pen = 1 if (x["source"] == "GO" and is_generic_go_name(x["name"])) else 0
        return (base + go_pen + hall, -x["size"], 0, x["id"])

    curated_sorted = sorted(curated, key=priority_key)
    kept = []
    kept_sets = []
    for cand in curated_sorted:
        cset = set(cand["genes"])
        too_similar = False
        for ks in kept_sets:
            inter = len(cset & ks)
            uni = len(cset | ks)
            if uni == 0:
                continue
            j = inter / uni
            if j > 0.8:
                too_similar = True
                break
        if not too_similar:
            kept.append(cand)
            kept_sets.append(cset)
    return kept, pruned_blacklist


def prune_ubiquitous_genes_in_B(B: csr_matrix,
                                genes: List[str],
                                marker_genes: Set[str],
                                quantile: float = UBIQUITY_PRUNE_Q) -> Tuple[csr_matrix, np.ndarray, Set[str]]:
    # df: number of sets per gene
    df = np.array(B.sum(axis=1)).ravel()
    if df.size == 0:
        return B, df, set()
    thr = np.quantile(df[df > 0], quantile) if (df > 0).any() else np.inf
    to_prune_idx = np.where((df >= thr))[0]
    # Keep marker genes
    marker_mask = np.array([genes[i] in marker_genes for i in to_prune_idx])
    rows_to_zero = to_prune_idx[~marker_mask]
    # Zero-out memberships for selected rows
    if rows_to_zero.size > 0:
        B = B.tolil()
        for r in rows_to_zero:
            B.rows[r] = []
            B.data[r] = []
        B = B.tocsr()
    # Recompute df after pruning
    df_new = np.array(B.sum(axis=1)).ravel()
    pruned_gene_names = set([genes[i] for i in rows_to_zero.tolist()])
    return B, df_new, pruned_gene_names


def build_membership_matrices(genes: List[str], curated_sets: List[Dict]) -> Tuple[csr_matrix, np.ndarray]:
    gene_to_idx = {g: i for i, g in enumerate(genes)}
    n_genes = len(genes)
    n_sets = len(curated_sets)
    rows = []
    cols = []
    for j, gs in enumerate(curated_sets):
        for g in gs["genes"]:
            i = gene_to_idx.get(g, None)
            if i is not None:
                rows.append(i)
                cols.append(j)
    data = np.ones(len(rows), dtype=np.uint8)
    B = csr_matrix((data, (np.array(rows), np.array(cols))), shape=(n_genes, n_sets), dtype=np.uint8)
    df = np.array(B.sum(axis=1)).ravel()
    return B, df


def compute_tfidf_and_normalize(B: csr_matrix) -> csr_matrix:
    # idf = log((1 + n_sets)/(1 + df)) + 1; L2-normalize columns
    n_sets = B.shape[1]
    df = np.array(B.sum(axis=1)).ravel().astype(np.float32)
    idf = np.log((1.0 + n_sets) / (1.0 + df)) + 1.0
    D = sp.diags(idf.astype(np.float32))
    X = (D @ B).astype(np.float32)
    # L2 normalize columns
    col_sq = np.array(X.power(2).sum(axis=0)).ravel()
    col_norm = np.sqrt(np.maximum(col_sq, 1e-12))
    inv_col = sp.diags((1.0 / col_norm).astype(np.float32))
    Xn = (X @ inv_col).astype(np.float32)
    return Xn


def build_gene_graph_adaptive(B: csr_matrix, genes: List[str],
                              target_degree_range: Tuple[int, int] = (10, 30),
                              default_threshold: float = 0.1) -> Tuple[pd.DataFrame, float]:
    import pandas as pd
    # Active genes
    df = np.array(B.sum(axis=1)).ravel()
    active_idx = np.where(df > 0)[0]
    if active_idx.size == 0:
        return pd.DataFrame(columns=["gene_i", "gene_j", "weight"]), default_threshold
    B_active = B[active_idx, :].astype(np.uint16)
    # Co-membership counts
    C = (B_active @ B_active.T).tocsr()
    s = np.array(B_active.sum(axis=1)).ravel()
    weights = []
    pairs = []
    indptr = C.indptr
    indices = C.indices
    data = C.data
    for ai in range(C.shape[0]):
        start = indptr[ai]
        end = indptr[ai + 1]
        row_idx = indices[start:end]
        row_val = data[start:end]
        si = s[ai]
        for k, aj in enumerate(row_idx):
            if aj <= ai:
                continue
            cij = row_val[k]
            if cij <= 0:
                continue
            sj = s[aj]
            union = si + sj - cij
            if union <= 0:
                continue
            jacc = float(cij) / float(union)
            if jacc > 0:
                pairs.append((ai, aj))
                weights.append(jacc)
    if len(weights) == 0:
        return pd.DataFrame(columns=["gene_i", "gene_j", "weight"]), default_threshold
    w = np.array(weights, dtype=np.float32)
    # Choose threshold to target average degree
    qs = np.linspace(0.5, 0.95, 10)
    chosen_t = default_threshold
    chosen_deg = 0.0
    N = active_idx.size
    best_gap = float("inf")
    target_mid = 0.5 * (target_degree_range[0] + target_degree_range[1])
    for q in qs:
        t = float(np.quantile(w, q))
        E = int(np.sum(w >= t))
        avg_deg = (2.0 * E) / max(1, N)
        # choose within range else minimize gap to mid
        if target_degree_range[0] <= avg_deg <= target_degree_range[1]:
            # pick the first acceptable (increasing q lowers E)
            chosen_t = t
            chosen_deg = avg_deg
            break
        else:
            gap = abs(avg_deg - target_mid)
            if gap < best_gap:
                best_gap = gap
                chosen_t = t
                chosen_deg = avg_deg
    # Build edges >= chosen_t, and symmetrize
    edges_i = []
    edges_j = []
    edge_w = []
    for (idx, (ai, aj)) in enumerate(pairs):
        if w[idx] >= chosen_t:
            gi = genes[active_idx[ai]]
            gj = genes[active_idx[aj]]
            wij = float(w[idx])
            edges_i.append(gi); edges_j.append(gj); edge_w.append(wij)
            edges_i.append(gj); edges_j.append(gi); edge_w.append(wij)
    df_edges = pd.DataFrame({"gene_i": edges_i, "gene_j": edges_j, "weight": edge_w})
    return df_edges, chosen_t


def load_marker_sets(path: str,
                     mapping: Dict[str, str],
                     dataset_genes: Set[str],
                     detection_frac: Dict[str, float],
                     df_counts: Optional[Dict[str, int]] = None) -> Dict[str, List[str]]:
    df = pd.read_excel(path)
    for col in ["species", "cancer_or_normal", "cell_type", "Symbol", "marker"]:
        if col not in df.columns:
            df[col] = np.nan
    species_col = df["species"].astype(str).str.lower()
    human_mask = species_col.str.contains("human") | species_col.str.contains("homo sapiens")
    df = df[human_mask].copy()
    if "cancer_or_normal" in df.columns:
        con = df["cancer_or_normal"].astype(str).str.lower()
        normal_mask = con.str.contains("normal", na=False)
        if normal_mask.any():
            df = df[normal_mask].copy()
    df["cell_type"] = df["cell_type"].astype(str).str.strip()
    marker_map: Dict[str, List[str]] = {}
    for ct, sub in df.groupby("cell_type"):
        genes_list = []
        symb = sub["Symbol"].dropna().astype(str).tolist()
        genes_list.extend(symb)
        if len(genes_list) == 0:
            mark_text = sub["marker"].dropna().astype(str).tolist()
            for t in mark_text:
                genes_list.extend(parse_gene_list(t))
        if len(genes_list) == 0:
            continue
        genes_list = map_and_merge_symbols(genes_list, mapping)
        # Intersect with dataset expressed genes
        genes_list = [g for g in genes_list if g in dataset_genes]
        if len(genes_list) == 0:
            continue
        # Rank by detection (high) and ubiquity (low if provided)
        uniq = sorted(set(genes_list))
        scores = []
        max_df = max(df_counts.values()) if (df_counts is not None and len(df_counts) > 0) else 1
        for g in uniq:
            det = detection_frac.get(g, 0.0)
            ubiq = (df_counts.get(g, 0) / max_df) if (df_counts is not None) else 0.0
            score = det - 0.1 * ubiq
            scores.append((score, g))
        scores.sort(reverse=True)
        ordered = [g for _, g in scores]
        # Enforce 5–50 markers per cell type if available
        top_n = min(50, len(ordered))
        selected = ordered[:top_n]
        if len(selected) < 5 and len(ordered) >= 5:
            selected = ordered[:5]
        if len(selected) == 0:
            continue
        marker_map[ct] = selected
    return marker_map


def compute_gene_weights(genes: List[str],
                         marker_sets: Dict[str, List[str]],
                         df_counts: np.ndarray,
                         pseudogenes: Set[str],
                         rrna: Set[str]) -> pd.DataFrame:
    n = len(genes)
    weights = np.ones(n, dtype=np.float32)
    reasons: List[List[str]] = [[] for _ in range(n)]
    gene_to_idx = {g: i for i, g in enumerate(genes)}
    # Downweight categories first
    for i, g in enumerate(genes):
        low_value = (
            g.startswith("MT-") or g == "MALAT1" or g.startswith("RPL") or g.startswith("RPS") or
            (g in pseudogenes) or (g in rrna) or g.startswith("LINC") or g.startswith("SNORD") or g.startswith("SNORA")
        )
        if low_value:
            weights[i] = 0.25
            if g.startswith("MT-"):
                reasons[i].append("mitochondrial")
            elif g.startswith("RP"):
                reasons[i].append("ribosomal")
            elif g == "MALAT1":
                reasons[i].append("MALAT1")
            elif g in rrna:
                reasons[i].append("rRNA")
            elif g in pseudogenes:
                reasons[i].append("pseudogene")
            elif g.startswith("LINC"):
                reasons[i].append("lincRNA")
            else:
                reasons[i].append("snorna/snord")
    # Marker boost
    marker_genes = set()
    for glist in marker_sets.values():
        marker_genes.update(glist)
    for g in marker_genes:
        i = gene_to_idx.get(g, None)
        if i is not None and weights[i] > 0.25 - 1e-8:
            weights[i] += 0.5
            reasons[i].append("marker")
    # Pathway-specific boost (low global set-frequency among genes with df>0)
    df_pos = df_counts[df_counts > 0]
    thr = np.quantile(df_pos, 0.2) if df_pos.size > 0 else 0
    for i, cnt in enumerate(df_counts):
        if cnt > 0 and cnt <= thr and weights[i] > 0.25 - 1e-8:
            weights[i] += 0.25
            reasons[i].append("pathway_specific")
    # Clip
    weights = np.clip(weights, 0.25, 2.0)
    reason_str = [";".join(r) if len(r) > 0 else "default" for r in reasons]
    dfw = pd.DataFrame({"gene": genes, "weight": weights.astype(np.float32), "reason": reason_str})
    return dfw


def main():
    import pandas as pd
    ensure_dir(PRIOR_OUTPUT_DIR)

    # Load meta info mapping and flags
    mapping, pseudogenes, _, rrna = load_meta_info(META_INFO_PATH)

    # Load dataset genes and detection fractions (prefer preprocessed training features)
    genes, detection_frac = load_dataset_genes_and_detection(PREPROC_TRAIN_H5AD, INPUT_MOD1, mapping, detect_thresh=DETECT_FRAC_THRESH)
    n_genes = len(genes)
    gene_to_idx = {g: i for i, g in enumerate(genes)}
    dataset_gene_set = set(genes)

    # Save gene_index.json
    gene_index_obj = {"genes": genes, "index_by_gene": gene_to_idx}
    with open(GENE_INDEX_JSON, "w") as f:
        json.dump(gene_index_obj, f)
    assert os.path.exists(GENE_INDEX_JSON)
    with open(GENE_INDEX_JSON, "r") as f:
        j = json.load(f)
    assert isinstance(j.get("genes", None), list) and isinstance(j.get("index_by_gene", None), dict)
    assert len(j["genes"]) == n_genes
    for i, g in enumerate(j["genes"]):
        assert j["index_by_gene"][g] == i

    # Preliminary marker sets (detection-aware; ubiquity-aware updated later)
    prelim_marker_sets = load_marker_sets(CELL_MARKER_PATH, mapping, dataset_gene_set, detection_frac, df_counts=None)
    with open(MARKER_SETS_JSON, "w") as f:
        json.dump(prelim_marker_sets, f)
    assert os.path.exists(MARKER_SETS_JSON)

    # Low-value blacklist for curated sets (except if gene appears in retained marker panels)
    low_value_blacklist = set()
    low_value_blacklist.update([g for g in genes if g.startswith("MT-")])
    low_value_blacklist.update([g for g in genes if g.startswith("RPL") or g.startswith("RPS")])
    low_value_blacklist.update([g for g in genes if g == "MALAT1"])
    low_value_blacklist.update(pseudogenes)
    low_value_blacklist.update(rrna)
    low_value_blacklist.update([g for g in genes if g.startswith("LINC") or g.startswith("SNORD") or g.startswith("SNORA")])
    marker_gene_whitelist = set([g for lst in prelim_marker_sets.values() for g in lst])

    # Load prior resources
    msigdb_sets = parse_msigdb(MSIGDB_PATH, mapping)
    go_sets = parse_go_terms(GO_TERMS_PATH, mapping)
    nest_sets = parse_nest(NEST_PATH, mapping)
    all_sets_raw = msigdb_sets + go_sets + nest_sets

    # Curate and filter gene sets (expression- and quality-aware)
    curated_sets, pruned_blacklist = curate_gene_sets(all_sets_raw, dataset_gene_set, detection_frac, marker_gene_whitelist, low_value_blacklist)
    n_sets = len(curated_sets)
    assert n_sets > 0

    # Build membership matrix
    B, df_counts = build_membership_matrices(genes, curated_sets)

    # Persist initial gene_set_frequency for diagnostics (pre-prune ubiquity)
    df_freq = pd.DataFrame({"gene": genes, "df_counts": df_counts.astype(np.int64)})
    df_freq.to_csv(GENE_SET_FREQ_CSV, index=False)

    # Prune ubiquitous genes from memberships (except marker genes)
    B_pruned, df_counts2, ubiq_pruned_genes = prune_ubiquitous_genes_in_B(B, genes, marker_gene_whitelist, quantile=UBIQUITY_PRUNE_Q)

    # Compute TF-IDF with improved normalization on pruned B
    B_tfidf = compute_tfidf_and_normalize(B_pruned)

    # Save membership matrices
    save_npz(GENESET_MEMBERSHIP_NPZ, B_pruned.astype(np.uint8))
    assert os.path.exists(GENESET_MEMBERSHIP_NPZ)
    B_loaded = load_npz(GENESET_MEMBERSHIP_NPZ)
    assert B_loaded.shape == (n_genes, n_sets)

    save_npz(GENESET_MEMBERSHIP_TFIDF_NPZ, B_tfidf.astype(np.float32))
    assert os.path.exists(GENESET_MEMBERSHIP_TFIDF_NPZ)
    Btf_loaded = load_npz(GENESET_MEMBERSHIP_TFIDF_NPZ)
    assert Btf_loaded.shape == (n_genes, n_sets)

    # Gene set index mapping (order consistency)
    set_ids = [f"{gs['source']}:{gs['id']}" for gs in curated_sets]
    with open(GENESET_INDEX_JSON, "w") as f:
        json.dump(set_ids, f)
    assert os.path.exists(GENESET_INDEX_JSON)

    # Gene set metadata (include set_index and column norms)
    # Compute binary L1 per set (nnz per column) and TF-IDF L2 norm (should be 1.0 by construction)
    col_l1 = np.array(B_pruned.sum(axis=0)).ravel().astype(int).tolist()
    meta_rows = []
    for j, gs in enumerate(curated_sets):
        meta_rows.append({
            "set_index": j,
            "set_id": set_ids[j],
            "name": gs["name"],
            "source": gs["source"],
            "size": int(gs["size"]),
            "retained_fraction": float(gs["retained_fraction"]),
            "median_detection": float(gs.get("median_detection", np.nan)),
            "binary_col_l1": int(col_l1[j]),
            "tfidf_col_l2": 1.0,  # after L2 normalization
            "notes": ""
        })
    df_meta = pd.DataFrame(meta_rows, columns=["set_index", "set_id", "name", "source", "size", "retained_fraction", "median_detection", "binary_col_l1", "tfidf_col_l2", "notes"])
    df_meta.to_csv(GENESET_METADATA_CSV, index=False)
    assert os.path.exists(GENESET_METADATA_CSV)

    # Build adaptive gene graph and persist (symmetrized)
    import pandas as pd
    df_edges, chosen_edge_thresh = build_gene_graph_adaptive(B_pruned.astype(np.uint8), genes, target_degree_range=(10, 30), default_threshold=0.1)
    df_edges.to_csv(GENE_GRAPH_EDGES_CSV, index=False)
    assert os.path.exists(GENE_GRAPH_EDGES_CSV)
    df_edges_chk = pd.read_csv(GENE_GRAPH_EDGES_CSV)
    for col in ["gene_i", "gene_j", "weight"]:
        assert col in df_edges_chk.columns

    # Recompute marker sets ranking with df_counts2 (ubiquity-aware)
    df_counts_dict = {g: int(df_counts2[i]) for i, g in enumerate(genes)}
    marker_sets = load_marker_sets(CELL_MARKER_PATH, mapping, dataset_gene_set, detection_frac, df_counts=df_counts_dict)
    with open(MARKER_SETS_JSON, "w") as f:
        json.dump(marker_sets, f)
    assert os.path.exists(MARKER_SETS_JSON)

    # Gene weights (expanded downweighting)
    df_weights = compute_gene_weights(genes, marker_sets, df_counts2, pseudogenes, rrna)
    df_weights.to_csv(GENE_WEIGHTS_CSV, index=False)
    assert os.path.exists(GENE_WEIGHTS_CSV)

    # Diagnostics: coverage stats and pruned genes
    coverage_stats = {
        "num_genes": n_genes,
        "num_sets": n_sets,
        "median_set_size": float(np.median([r["size"] for r in curated_sets])) if n_sets > 0 else 0.0,
        "mean_set_size": float(np.mean([r["size"] for r in curated_sets])) if n_sets > 0 else 0.0,
        "median_set_detection": float(np.median([r.get("median_detection", 0.0) for r in curated_sets])) if n_sets > 0 else 0.0,
        "ubiquity_prune_quantile": UBIQUITY_PRUNE_Q,
        "graph_edge_threshold": float(chosen_edge_thresh),
    }
    with open(COVERAGE_STATS_JSON, "w") as f:
        json.dump(coverage_stats, f, indent=2)
    with open(PRUNED_GENES_CSV, "w") as f:
        pd.Series(sorted(list((pruned_blacklist | ubiq_pruned_genes)))).to_csv(f, index=False, header=["gene"])

    # Prior config aligned to downstream training defaults
    prior_config = {
        "use_tfidf": True,
        "graph_edge_threshold": float(chosen_edge_thresh),
        "lambda_graph": 0.001,
        "lambda_residual_l1": 0.0005,
        "lambda_marker_exclusivity": 0.001,
        "lambda_z": 0.0001,
        "residual_dim": 64,
        "reconstruction_loss_weights": GENE_WEIGHTS_CSV,
        "num_genes": n_genes,
        "num_sets": n_sets,
        "sources_priority": SOURCE_PRIORITY
    }
    with open(PRIOR_CONFIG_JSON, "w") as f:
        json.dump(prior_config, f, indent=2)
    assert os.path.exists(PRIOR_CONFIG_JSON)
    with open(PRIOR_CONFIG_JSON, "r") as f:
        pc = json.load(f)
    for k in ["use_tfidf", "graph_edge_threshold", "lambda_graph", "lambda_residual_l1", "lambda_marker_exclusivity", "lambda_z", "residual_dim", "reconstruction_loss_weights"]:
        assert k in pc


if __name__ == "__main__":
    main()
