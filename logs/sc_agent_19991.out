import os
import json
import re
from typing import Dict, List, Tuple, Set, Optional
import numpy as np
import pandas as pd
import anndata as ad
from scipy import sparse as sp
from scipy.sparse import csr_matrix, save_npz, load_npz

# Fixed input paths
INPUT_MOD1 = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/RNA_count.h5ad"
PREPROC_TRAIN_H5AD = "/home/mcb/users/ekourb/singlecell_Agent/runs/results/intermediate_output/step_0/preprocess_train_mod1.h5ad"

MSIGDB_PATH = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/MsigDB.csv"
NEST_PATH = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/NeST.tsv"
GO_TERMS_PATH = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/GO_terms.csv"
