# Constants
RANDOM_STATE = 42
TARGET_SUM = 1e4
HVG_TOP_N = 3000
MODEL_GENE_CAP = 7000
NONPRIOR_HVG_QUOTA_FRAC = 0.3  # reserve >=30% of cap for non-prior HVGs
SET_MIN_SIZE = 5
SET_MAX_KEEP = 1500
SET_MIN_TARGET = 800  # min kept sets target (enforce 800–1500 window)
MIN_PER_SET_COVERAGE = 5  # guarantee per-set coverage when capping (top sets only, round-robin)
