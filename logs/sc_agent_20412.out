|PRIOR_CODE|: import os
import json
import re
from typing import List, Dict, Tuple, Set
import numpy as np
import pandas as pd
import anndata as ad
from scipy.sparse import csr_matrix, diags, eye, save_npz, load_npz

# Fixed input/output paths (do not modify)
INPUT_MOD1 = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/RNA_count.h5ad"
DATASET_DIR = "/home/mcb/users/ekourb/singlecell_Agent/Datasets"
PRIOR_OUTPUT_DIR = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/prior"

# Prior resource files
MSIGDB_PATH = os.path.join(DATASET_DIR, "MsigDB.csv")
GO_PATH = os.path.join(DATASET_DIR, "GO_terms.csv")
MARKER_PATH = os.path.join(DATASET_DIR, "Cell_marker_Human.xlsx")
NEST_PATH = os.path.join(DATASET_DIR, "NeST.tsv")
META_INFO_PATH = os.path.join(DATASET_DIR, "meta_info.csv")

# Artifact output files
PRIOR_GENES_CSV = os.path.join(PRIOR_OUTPUT_DIR, "prior_genes.csv")
PRIOR_GENE_SYMBOL_MAP_CSV = os.path.join(PRIOR_OUTPUT_DIR, "prior_gene_symbol_map.csv")
PRIOR_GENE_SET_MEM_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "prior_gene_set_membership.npz")
PRIOR_GENE_SETS_META_CSV = os.path.join(PRIOR_OUTPUT_DIR, "prior_gene_sets_metadata.csv")
PRIOR_REG_ADJ_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "prior_regulatory_adj.npz")
PRIOR_REG_LAPL_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "prior_regulatory_laplacian.npz")
PRIOR_SET_WEIGHTS_JSON = os.path.join(PRIOR_OUTPUT_DIR, "prior_set_weights.json")
PRIOR_SUMMARY_JSON = os.path.join(PRIOR_OUTPUT_DIR, "prior_summary.json")


def ensure_dir(p: str):
    if not os.path.exists(p):
        os.makedirs(p, exist_ok=True)


def standardize_symbol(name: str) -> str:
    if name is None:
        return ""
    s = str(name).strip()
    # Strip version suffixes (e.g., AL627309.1 -> AL627309; ENSG000001.12 -> ENSG000001)
    s = re.sub(r"\.\d+$", "", s)
    s = s.upper()
    # Remove trailing/leading whitespace and unusual unicode spaces
    s = re.sub(r"\s+", "", s)
    return s


def parse_gene_list(gene_str: str) -> List[str]:
    if pd.isna(gene_str):
        return []
    s = str(gene_str)
    # Replace common separators with comma
    s = re.sub(r"[\|\;\t]", ",", s)
    # Also split on whitespace and commas
    toks = re.split(r"[,\s]+", s)
    toks = [t for t in toks if t and t != 'NA']
    return toks


def build_symbol_map(dataset_genes: List[str], meta_df: pd.DataFrame) -> Tuple[List[str], pd.DataFrame, Dict[str, int]]:
    # Create initial mapping to standardized symbols
    std_symbols = [standardize_symbol(g) for g in dataset_genes]

    # If meta_info provides canonical symbols, map when possible
    # Build lookup maps from meta_info
    meta = meta_df.copy()
    if "gene" in meta.columns:
        meta["gene_std"] = meta["gene"].astype(str).map(standardize_symbol)
    else:
        meta["gene_std"] = ""
    if "summary_symbol" in meta.columns:
        meta["summary_symbol_std"] = meta["summary_symbol"].astype(str).map(standardize_symbol)
    else:
        meta["summary_symbol_std"] = ""

    # Prefer human species if column exists
    if "species" in meta.columns:
        human_mask = meta["species"].astype(str).str.contains("Homo sapiens", case=False, na=False)
        meta_human = meta[human_mask]
    else:
        meta_human = meta

    # Build a map: any alias (gene_std or summary_symbol_std) -> summary_symbol_std
    alias_to_canonical: Dict[str, str] = {}
    for _, row in meta_human.iterrows():
        alias = row.get("gene_std", "")
        canonical = row.get("summary_symbol_std", "") or alias
        if alias:
            alias_to_canonical[alias] = canonical
        # Also add reverse mapping from summary_symbol_std to itself
        if row.get("summary_symbol_std", ""):
            alias_to_canonical[row["summary_symbol_std"]] = row["summary_symbol_std"]

    mapped_symbols = []
    for s in std_symbols:
        if s in alias_to_canonical:
            mapped_symbols.append(alias_to_canonical[s])
        else:
            mapped_symbols.append(s)

    # Build unique ordered list for prior_genes.csv, keeping first occurrence
    seen: Set[str] = set()
    unique_symbols = []
    for s in mapped_symbols:
        if s and (s not in seen):
            seen.add(s)
            unique_symbols.append(s)

    # Build symbol map dataframe
    kept_set = set(unique_symbols)
    map_records = []
    for orig, std, mapped in zip(dataset_genes, std_symbols, mapped_symbols):
        status = "kept" if (mapped in kept_set) else "dropped"
        map_records.append({"original_symbol": orig, "standardized_symbol": mapped, "status": status})
    map_df = pd.DataFrame(map_records)

    # Index mapping: symbol -> index in unique_symbols
    symbol_to_index = {s: i for i, s in enumerate(unique_symbols)}
    return unique_symbols, map_df, symbol_to_index


def load_gene_sets(msigdb_path: str, go_path: str, marker_path: str) -> List[Dict]:
    sets = []

    # MSigDB
    if os.path.exists(msigdb_path):
        msig = pd.read_csv(msigdb_path)
        # Expect columns: ID, Name, Count, Genes
        for _, row in msig.iterrows():
            name = str(row.get("Name", row.get("ID", "")))
            genes = parse_gene_list(row.get("Genes", ""))
            sets.append({
                "name": name,
                "source": "MSigDB",
                "type": "MSigDB",
                "description": str(row.get("Name", "")),
                "genes": [standardize_symbol(g) for g in genes]
            })

    # GO terms
    if os.path.exists(go_path):
        go = pd.read_csv(go_path)
        # Expect columns: GO, Genes, Gene_Count, Term_Description
        for _, row in go.iterrows():
            go_id = str(row.get("GO", ""))
            desc = str(row.get("Term_Description", ""))
            name = f"{go_id}:{desc}" if desc else go_id
            genes = parse_gene_list(row.get("Genes", ""))
            sets.append({
                "name": name,
                "source": "GO",
                "type": "GO",
                "description": desc,
                "genes": [standardize_symbol(g) for g in genes]
            })

    # Cell markers (per cell_type)
    if os.path.exists(marker_path):
        mk = pd.read_excel(marker_path)
        # Filter human rows if species column exists
        if "species" in mk.columns:
            mk = mk[mk["species"].astype(str).str.contains("human", case=False, na=False)]
        # Group by cell_type, aggregate Symbols
        symbol_col = "Symbol" if "Symbol" in mk.columns else "marker"
        celltype_col = "cell_type" if "cell_type" in mk.columns else None
        if celltype_col is not None and symbol_col in mk.columns:
            grouped = mk.groupby(celltype_col)[symbol_col].apply(lambda s: ",".join(map(str, s.tolist()))).reset_index()
            for _, row in grouped.iterrows():
                ct = str(row[celltype_col])
                genes = parse_gene_list(row[symbol_col])
                sets.append({
                    "name": f"marker:{ct}",
                    "source": "Marker",
                    "type": "marker",
                    "description": f"Markers aggregated for cell type {ct}",
                    "genes": [standardize_symbol(g) for g in genes]
                })

    return sets


def filter_and_dedup_sets(sets: List[Dict], gene_universe: Set[str], size_min: int = 10, size_max: int = 300,
                          jaccard_thresh: float = 0.8) -> List[Dict]:
    # Intersect with gene universe and filter by size
    filtered = []
    for s in sets:
        gs = set([g for g in s["genes"] if g in gene_universe])
        if size_min <= len(gs) <= size_max:
            s2 = s.copy()
            s2["genes_in_data"] = gs
            s2["size_in_data"] = len(gs)
            filtered.append(s2)

    # Sort by priority then by size descending
    priority = {"marker": 0, "Marker": 0, "MSigDB": 1, "GO": 2}
    def sort_key(s):
        return (priority.get(s["type"], priority.get(s["source"], 3)), -s["size_in_data"])
    filtered.sort(key=sort_key)

    # Greedy de-duplication by Jaccard
    kept = []
    kept_sets = []
    for s in filtered:
        keep = True
        gs = s["genes_in_data"]
        for t in kept_sets:
            inter = len(gs & t["genes_in_data"])
            union = len(gs | t["genes_in_data"])
            jacc = inter / union if union > 0 else 0.0
            if jacc > jaccard_thresh:
                keep = False
                break
        if keep:
            kept_sets.append(s)

    return kept_sets


def compute_normalized_log1p_and_gene_var(adata: ad.AnnData) -> np.ndarray:
    X = adata.X
    n_cells = adata.n_obs
    # Expect sparse CSR or CSC
    if not hasattr(X, "tocoo"):
        # Convert dense to CSR
        X = csr_matrix(X)
    if not isinstance(X, csr_matrix):
        X = X.tocsr()

    # Library size normalization to 1e4 per cell
    cell_sums = np.array(X.sum(axis=1)).flatten()
    scale = 1e4 / np.maximum(cell_sums, 1.0)
    S = diags(scale)
    Xn = S.dot(X)
    # log1p
    Xn = Xn.tocsr(copy=True)
    Xn.data = np.log1p(Xn.data)

    # Mean per gene
    mean = np.array(Xn.mean(axis=0)).flatten()
    # E[x^2]
    sq = Xn.multiply(Xn)
    ex2 = np.array(sq.mean(axis=0)).flatten()
    var = ex2 - (mean ** 2)
    var[var < 0] = 0.0
    return var.astype(np.float32)


def select_sets_by_ic(sets: List[Dict], gene_index: Dict[str, int], gene_var: np.ndarray,
                      topk_min: int = 800, topk_max: int = 1500) -> List[Dict]:
    ic_scores = []
    for s in sets:
        idx = [gene_index[g] for g in s["genes_in_data"] if g in gene_index]
        if len(idx) == 0:
            ic = 0.0
        else:
            ic = float(np.mean(gene_var[idx])) * (np.log10(len(idx)) if len(idx) > 0 else 0.0)
        ic_scores.append(ic)
    # Attach and sort by IC desc
    for i, s in enumerate(sets):
        s["IC"] = ic_scores[i]
    sets_sorted = sorted(sets, key=lambda x: x["IC"], reverse=True)

    n = len(sets_sorted)
    if n <= topk_min:
        selected = sets_sorted
    else:
        dynamic_k = int(max(topk_min, min(topk_max, max(topk_min, int(0.33 * n)))))
        selected = sets_sorted[:dynamic_k]
    return selected


def build_membership_matrix(selected_sets: List[Dict], symbol_to_index: Dict[str, int]) -> Tuple[csr_matrix, List[str]]:
    # Compute gene frequencies across sets
    gene_freq: Dict[str, int] = {}
    for s in selected_sets:
        for g in s["genes_in_data"]:
            gene_freq[g] = gene_freq.get(g, 0) + 1

    # Build CSR components
    rows = []
    cols = []
    data = []
    for j, s in enumerate(selected_sets):
        for g in s["genes_in_data"]:
            if g in symbol_to_index:
                i = symbol_to_index[g]
                freq = gene_freq.get(g, 1)
                w = 1.0 / np.log(2.0 + float(freq))
                rows.append(i)
                cols.append(j)
                data.append(w)

    n_genes = len(symbol_to_index)
    n_sets = len(selected_sets)
    M = csr_matrix((np.array(data, dtype=np.float32),
                    (np.array(rows, dtype=np.int64), np.array(cols, dtype=np.int64))),
                   shape=(n_genes, n_sets), dtype=np.float32)
    set_ids = [f"S{j}" for j in range(n_sets)]
    return M, set_ids


def compute_set_weights(selected_sets: List[Dict], set_ids: List[str]) -> Dict[str, float]:
    # λ_s = λ0 * scale(source) / (log2(size_s)+1)
    lambda0 = 1.0
    scale_map = {"marker": 0.5, "Marker": 0.5, "MSigDB": 1.0, "GO": 1.5}
    weights = {}
    for sid, s in zip(set_ids, selected_sets):
        size_s = max(1, s.get("size_in_data", len(s.get("genes_in_data", []))))
        src = s.get("type", s.get("source", "MSigDB"))
        scale = scale_map.get(src, 1.0)
        w = lambda0 * scale / (np.log2(size_s) + 1.0)
        weights[sid] = float(w)
    return weights


def build_regulatory_graph(nest_path: str, gene_symbol_to_index: Dict[str, int]) -> csr_matrix:
    # Build symmetric adjacency A from NeST TF-target edges
    n_genes = len(gene_symbol_to_index)
    if os.path.exists(nest_path):
        df = pd.read_csv(nest_path, sep="\t")
    else:
        df = pd.DataFrame(columns=["name_new", "Genes"])

    rows = []
    cols = []
    # Expect columns: name_new (TF), Genes (targets)
    for _, row in df.iterrows():
        tf = standardize_symbol(row.get("name_new", ""))
        targets = parse_gene_list(row.get("Genes", ""))
        targets = [standardize_symbol(t) for t in targets]
        if tf in gene_symbol_to_index:
            tf_idx = gene_symbol_to_index[tf]
            for tgt in targets:
                if tgt in gene_symbol_to_index:
                    tgt_idx = gene_symbol_to_index[tgt]
                    # Add undirected edges (we will symmetrize anyway)
                    rows.extend([tf_idx, tgt_idx])
                    cols.extend([tgt_idx, tf_idx])

    if len(rows) == 0:
        A = csr_matrix((n_genes, n_genes), dtype=np.float32)
    else:
        data = np.ones(len(rows), dtype=np.float32)
        A = csr_matrix((data, (np.array(rows, dtype=np.int64), np.array(cols, dtype=np.int64))),
                       shape=(n_genes, n_genes), dtype=np.float32)
        # Binarize and remove self loops
        A.data[:] = 1.0
        A.setdiag(0.0)
        A.eliminate_zeros()

    # Symmetrize: (A + A^T) > 0 -> binary
    A = (A + A.T).astype(np.float32)
    A.data[:] = 1.0
    A.setdiag(0.0)
    A.eliminate_zeros()
    return A


def normalized_laplacian(A: csr_matrix) -> csr_matrix:
    n = A.shape[0]
    deg = np.array(A.sum(axis=1)).flatten()
    with np.errstate(divide="ignore"):
        deg_inv_sqrt = 1.0 / np.sqrt(np.maximum(deg, 0.0))
    deg_inv_sqrt[np.isinf(deg_inv_sqrt)] = 0.0
    D_is = diags(deg_inv_sqrt.astype(np.float32))
    L = eye(n, dtype=np.float32, format="csr") - (D_is @ A @ D_is)
    L.setdiag(1.0)  # Ensure diagonal is 1 for isolated nodes
    return L.tocsr().astype(np.float32)


def write_and_assert_csv(df: pd.DataFrame, path: str, required_cols: List[str] = None):
    df.to_csv(path, index=False)
    assert os.path.exists(path), f"CSV not written: {path}"
    df2 = pd.read_csv(path)
    if required_cols is not None:
        for c in required_cols:
            assert c in df2.columns, f"Missing required column {c} in {path}"


def main():
    ensure_dir(PRIOR_OUTPUT_DIR)

    # Load dataset
    adata = ad.read_h5ad(INPUT_MOD1)
    n_cells, n_features = adata.n_obs, adata.n_vars
    dataset_genes = list(map(str, adata.var_names.tolist()))

    # Load meta info
    meta_df = pd.read_csv(META_INFO_PATH) if os.path.exists(META_INFO_PATH) else pd.DataFrame(columns=["gene", "summary_symbol"])

    # Build standardized gene list and symbol map
    prior_genes, gene_symbol_map_df, symbol_to_index = build_symbol_map(dataset_genes, meta_df)
    n_genes = len(prior_genes)

    # Flags for mitochondrial and ribosomal genes
    is_mt = [1 if g.startswith("MT-") else 0 for g in prior_genes]
    is_ribo = [1 if (g.startswith("RPS") or g.startswith("RPL")) else 0 for g in prior_genes]

    # Write prior_genes.csv
    prior_genes_df = pd.DataFrame({
        "standardized_symbol": prior_genes,
        "gene_index": list(range(n_genes)),
        "is_mt": is_mt,
        "is_ribo": is_ribo
    })
    write_and_assert_csv(prior_genes_df, PRIOR_GENES_CSV, required_cols=["standardized_symbol", "gene_index", "is_mt", "is_ribo"])

    # Write gene symbol map
    write_and_assert_csv(gene_symbol_map_df, PRIOR_GENE_SYMBOL_MAP_CSV, required_cols=["original_symbol", "standardized_symbol", "status"])

    # Load gene sets from resources
    raw_sets = load_gene_sets(MSIGDB_PATH, GO_PATH, MARKER_PATH)

    # Filter and deduplicate
    gene_universe = set(prior_genes)
    size_min, size_max = 10, 300
    jaccard_thresh = 0.8
    filtered_sets = filter_and_dedup_sets(raw_sets, gene_universe, size_min=size_min, size_max=size_max, jaccard_thresh=jaccard_thresh)

    # Compute per-gene variance on normalized log1p counts for IC scoring
    gene_var = compute_normalized_log1p_and_gene_var(adata)

    # Select sets by IC within 800-1500
    selected_sets = select_sets_by_ic(filtered_sets, symbol_to_index, gene_var, topk_min=800, topk_max=1500)

    # Build membership matrix with IDF weights
    M, set_ids = build_membership_matrix(selected_sets, symbol_to_index)
    # Save membership
    save_npz(PRIOR_GENE_SET_MEM_NPZ, M)
    # Assert membership exists and shape/dtype
    assert os.path.exists(PRIOR_GENE_SET_MEM_NPZ), "Missing prior_gene_set_membership.npz"
    M_check = load_npz(PRIOR_GENE_SET_MEM_NPZ)
    assert M_check.shape[0] == n_genes, "Membership n_genes mismatch"
    assert M_check.shape[1] == len(selected_sets), "Membership n_sets mismatch"
    assert str(M_check.dtype) == "float32", "Membership dtype must be float32"

    # Build regulatory adjacency and laplacian
    A = build_regulatory_graph(NEST_PATH, symbol_to_index)
    save_npz(PRIOR_REG_ADJ_NPZ, A.astype(np.float32))
    assert os.path.exists(PRIOR_REG_ADJ_NPZ), "Missing prior_regulatory_adj.npz"
    A_check = load_npz(PRIOR_REG_ADJ_NPZ)
    assert A_check.shape == (n_genes, n_genes), "Adjacency shape mismatch"
    assert str(A_check.dtype) == "float32", "Adjacency dtype must be float32"

    L = normalized_laplacian(A_check)
    save_npz(PRIOR_REG_LAPL_NPZ, L.astype(np.float32))
    assert os.path.exists(PRIOR_REG_LAPL_NPZ), "Missing prior_regulatory_laplacian.npz"
    L_check = load_npz(PRIOR_REG_LAPL_NPZ)
    assert L_check.shape == (n_genes, n_genes), "Laplacian shape mismatch"
    assert str(L_check.dtype) == "float32", "Laplacian dtype must be float32"

    # Compute per-set weights
    set_weights = compute_set_weights(selected_sets, set_ids)
    with open(PRIOR_SET_WEIGHTS_JSON, "w") as f:
        json.dump(set_weights, f, indent=2)
    assert os.path.exists(PRIOR_SET_WEIGHTS_JSON), "Missing prior_set_weights.json"
    with open(PRIOR_SET_WEIGHTS_JSON, "r") as f:
        sw = json.load(f)
    assert isinstance(sw, dict) and len(sw) == len(set_ids), "Set weights dict mismatch"

    # Prepare gene set metadata
    # Normalize IC to [0,1] for weight_init
    ICs = np.array([s.get("IC", 0.0) for s in selected_sets], dtype=np.float32)
    if len(ICs) > 0:
        IC_min = float(np.min(ICs))
        IC_max = float(np.max(ICs))
        denom = (IC_max - IC_min) if (IC_max - IC_min) > 1e-8 else 1.0
        IC_norm = (ICs - IC_min) / denom
    else:
        IC_norm = np.array([], dtype=np.float32)

    meta_records = []
    for j, (sid, s) in enumerate(zip(set_ids, selected_sets)):
        meta_records.append({
            "set_id": sid,
            "name": s.get("name", sid),
            "source": s.get("source", s.get("type", "")),
            "type": s.get("type", s.get("source", "")),
            "size_in_data": int(s.get("size_in_data", len(s.get("genes_in_data", [])))),
            "description": s.get("description", ""),
            "weight_init": float(IC_norm[j]) if len(IC_norm) > j else 0.0
        })
    sets_meta_df = pd.DataFrame(meta_records)
    write_and_assert_csv(sets_meta_df, PRIOR_GENE_SETS_META_CSV, required_cols=["set_id", "name", "source", "type", "size_in_data", "description", "weight_init"])

    # Summary and provenance
    n_sets_raw = len(raw_sets)
    n_sets_filtered = len(filtered_sets)
    n_sets_selected = len(selected_sets)
    # Coverage: genes present in at least one selected set
    covered_genes = set()
    for s in selected_sets:
        covered_genes |= s["genes_in_data"]
    coverage_pct = 100.0 * (len(covered_genes) / max(1, n_genes))

    # Regulatory edges count (undirected)
    A_bin = A_check.copy()
    A_bin.data[:] = 1.0
    edges_undirected = int(A_bin.nnz // 2)

    summary = {
        "dataset": {
            "n_cells": int(n_cells),
            "n_genes_dataset": int(n_features),
            "n_genes_prior": int(n_genes)
        },
        "prior_resources": {
            "MsigDB_path": MSIGDB_PATH,
            "GO_terms_path": GO_PATH,
            "Cell_marker_Human_path": MARKER_PATH,
            "NeST_path": NEST_PATH,
            "meta_info_path": META_INFO_PATH
        },
        "thresholds": {
            "size_min": size_min,
            "size_max": size_max,
            "jaccard_threshold": jaccard_thresh,
            "topk_min": 800,
            "topk_max": 1500
        },
        "gene_sets": {
            "n_sets_raw": int(n_sets_raw),
            "n_sets_after_size_filter": int(n_sets_filtered),
            "n_sets_selected": int(n_sets_selected),
            "coverage_genes_in_selected_pct": float(coverage_pct)
        },
        "regulatory_graph": {
            "n_edges_undirected": int(edges_undirected),
            "adjacency_path": PRIOR_REG_ADJ_NPZ,
            "laplacian_path": PRIOR_REG_LAPL_NPZ
        },
        "artifacts": {
            "prior_genes_csv": PRIOR_GENES_CSV,
            "prior_gene_symbol_map_csv": PRIOR_GENE_SYMBOL_MAP_CSV,
            "prior_gene_set_membership_npz": PRIOR_GENE_SET_MEM_NPZ,
            "prior_gene_sets_metadata_csv": PRIOR_GENE_SETS_META_CSV,
            "prior_set_weights_json": PRIOR_SET_WEIGHTS_JSON,
            "prior_summary_json": PRIOR_SUMMARY_JSON
        }
    }
    with open(PRIOR_SUMMARY_JSON, "w") as f:
        json.dump(summary, f, indent=2)
    assert os.path.exists(PRIOR_SUMMARY_JSON), "Missing prior_summary.json"
    with open(PRIOR_SUMMARY_JSON, "r") as f:
        _ = json.load(f)

    # Final assertions of consistency
    # 1) Membership columns == metadata rows == set_weights entries
    M_loaded = load_npz(PRIOR_GENE_SET_MEM_NPZ)
    meta_loaded = pd.read_csv(PRIOR_GENE_SETS_META_CSV)
    with open(PRIOR_SET_WEIGHTS_JSON, "r") as f:
        weights_loaded = json.load(f)
    assert M_loaded.shape[1] == meta_loaded.shape[0], "Mismatch between membership n_sets and metadata rows"
    assert M_loaded.shape[1] == len(weights_loaded), "Mismatch between membership n_sets and set_weights entries"
    # 2) Gene rows == prior_genes
    prior_genes_loaded = pd.read_csv(PRIOR_GENES_CSV)
    assert M_loaded.shape[0] == prior_genes_loaded.shape[0], "Mismatch between membership n_genes and prior_genes rows"
    # 3) Adjacency/Laplacian shapes consistent with gene count
    A_loaded = load_npz(PRIOR_REG_ADJ_NPZ)
    L_loaded = load_npz(PRIOR_REG_LAPL_NPZ)
    assert A_loaded.shape == (prior_genes_loaded.shape[0], prior_genes_loaded.shape[0]), "Adjacency shape mismatch with prior_genes"
    assert L_loaded.shape == (prior_genes_loaded.shape[0], prior_genes_loaded.shape[0]), "Laplacian shape mismatch with prior_genes"


if __name__ == "__main__":
    main()
