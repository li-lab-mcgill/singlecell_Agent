import os
import json
import re
from typing import List, Dict, Tuple, Set
import numpy as np
import pandas as pd
import anndata as ad
from scipy.sparse import csr_matrix, diags, eye, save_npz, load_npz

# Fixed input/output paths (do not modify)
INPUT_MOD1 = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/RNA_count.h5ad"
DATASET_DIR = "/home/mcb/users/ekourb/singlecell_Agent/Datasets"
PRIOR_OUTPUT_DIR = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/prior"

# Prior resource files
MSIGDB_PATH = os.path.join(DATASET_DIR, "MsigDB.csv")
GO_PATH = os.path.join(DATASET_DIR, "GO_terms.csv")
MARKER_PATH = os.path.join(DATASET_DIR, "Cell_marker_Human.xlsx")
NEST_PATH = os.path.join(DATASET_DIR, "NeST.tsv")
META_INFO_PATH = os.path.join(DATASET_DIR, "meta_info.csv")

# Artifact output files
PRIOR_GENES_CSV = os.path.join(PRIOR_OUTPUT_DIR, "prior_genes.csv")
PRIOR_GENE_SYMBOL_MAP_CSV = os.path.join(PRIOR_OUTPUT_DIR, "prior_gene_symbol_map.csv")
PRIOR_GENE_SET_MEM_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "prior_gene_set_membership.npz")
PRIOR_GENE_SETS_META_CSV = os.path.join(PRIOR_OUTPUT_DIR, "prior_gene_sets_metadata.csv")
PRIOR_REG_ADJ_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "prior_regulatory_adj.npz")
PRIOR_REG_LAPL_NPZ = os.path.join(PRIOR_OUTPUT_DIR, "prior_regulatory_laplacian.npz")
PRIOR_SET_WEIGHTS_JSON = os.path.join(PRIOR_OUTPUT_DIR, "prior_set_weights.json")
PRIOR_SUMMARY_JSON = os.path.join(PRIOR_OUTPUT_DIR, "prior_summary.json")


def ensure_dir(p: str):
    if not os.path.exists(p):
        os.makedirs(p, exist_ok=True)


def standardize_symbol(name: str) -> str:
    if name is None:
        return ""
    s = str(name).strip()
    s = re.sub(r"\.\d+$", "", s)
    s = s.upper()
    s = re.sub(r"\s+", "", s)
    return s


def parse_gene_list(gene_str: str) -> List[str]:
    if pd.isna(gene_str):
        return []
    s = str(gene_str)
    s = re.sub(r"[\|\;\t]", ",", s)
    toks = re.split(r"[,\s]+", s)
    toks = [t for t in toks if t and t != 'NA']
    return toks


def create_alias_map(meta_df: pd.DataFrame) -> Dict[str, str]:
    meta = meta_df.copy()
    if "gene" in meta.columns:
        meta["gene_std"] = meta["gene"].astype(str).map(standardize_symbol)
    else:
        meta["gene_std"] = ""
    if "summary_symbol" in meta.columns:
        meta["summary_symbol_std"] = meta["summary_symbol"].astype(str).map(standardize_symbol)
    else:
        meta["summary_symbol_std"] = ""
    if "species" in meta.columns:
        human_mask = meta["species"].astype(str).str.contains("Homo sapiens", case=False, na=False)
        meta = meta[human_mask]
    alias_to_canonical: Dict[str, str] = {}
    for _, row in meta.iterrows():
        alias = row.get("gene_std", "")
        canonical = row.get("summary_symbol_std", "") or alias
        if alias:
            alias_to_canonical[alias] = canonical
        if row.get("summary_symbol_std", ""):
            alias_to_canonical[row["summary_symbol_std"]] = row["summary_symbol_std"]
    return alias_to_canonical


def map_symbols_alias(symbols: List[str], alias_to_canonical: Dict[str, str]) -> List[str]:
    out = []
    for s in symbols:
        ss = standardize_symbol(s)
        out.append(alias_to_canonical.get(ss, ss))
    return out


def build_symbol_map(dataset_genes: List[str], meta_df: pd.DataFrame) -> Tuple[List[str], pd.DataFrame, Dict[str, int], List[str]]:
    alias_to_canonical = create_alias_map(meta_df)
    std_symbols = [standardize_symbol(g) for g in dataset_genes]
    mapped_symbols = [alias_to_canonical.get(s, s) for s in std_symbols]
    seen: Set[str] = set()
    unique_symbols = []
    for s in mapped_symbols:
        if s and (s not in seen):
            seen.add(s)
            unique_symbols.append(s)
    kept_set = set(unique_symbols)
    map_records = []
    for orig, std, mapped in zip(dataset_genes, std_symbols, mapped_symbols):
        status = "kept" if (mapped in kept_set) else "dropped"
        map_records.append({"original_symbol": orig, "standardized_symbol": mapped, "status": status})
    map_df = pd.DataFrame(map_records)
    symbol_to_index = {s: i for i, s in enumerate(unique_symbols)}
    return unique_symbols, map_df, symbol_to_index, mapped_symbols


def load_gene_sets(msigdb_path: str, go_path: str, marker_path: str, alias_to_canonical: Dict[str, str]) -> List[Dict]:
    sets: List[Dict] = []

    if os.path.exists(msigdb_path):
        msig = pd.read_csv(msigdb_path)
        for _, row in msig.iterrows():
            name = str(row.get("Name", row.get("ID", "")))
            genes = parse_gene_list(row.get("Genes", ""))
            genes = map_symbols_alias(genes, alias_to_canonical)
            sets.append({
                "name": name,
                "source": "MSigDB",
                "type": "MSigDB",
                "description": str(row.get("Name", "")),
                "genes": genes
            })

    if os.path.exists(go_path):
        go = pd.read_csv(go_path)
        for _, row in go.iterrows():
            go_id = str(row.get("GO", ""))
            desc = str(row.get("Term_Description", ""))
            name = f"{go_id}:{desc}" if desc else go_id
            genes = parse_gene_list(row.get("Genes", ""))
            genes = map_symbols_alias(genes, alias_to_canonical)
            sets.append({
                "name": name,
                "source": "GO",
                "type": "GO",
                "description": desc,
                "genes": genes
            })

    if os.path.exists(marker_path):
        mk = pd.read_excel(marker_path)
        if "species" in mk.columns:
            mk = mk[mk["species"].astype(str).str.contains("human", case=False, na=False)]
        # Evidence/tissue-aware filtering
        has_pmids = "PMID" in mk.columns
        has_src = "marker_source" in mk.columns
        if has_pmids or has_src:
            ev_mask = False
            if has_pmids:
                ev_mask = ev_mask | mk["PMID"].notna()
            if has_src:
                ev_mask = ev_mask | mk["marker_source"].notna()
            mk = mk[ev_mask]
        # Focus on immune/blood-related tissues if available
        tissue_cols = [c for c in ["tissue_class", "tissue_type"] if c in mk.columns]
        if tissue_cols:
            tc = mk[tissue_cols].astype(str).agg(" ".join, axis=1).str.lower()
            keep_mask = tc.str.contains("blood|immune|hemat|leuk|lymph|pbmc", regex=True)
            mk = mk[keep_mask | keep_mask.isna()]  # keep rows without tissue annotation too

        symbol_col = "Symbol" if "Symbol" in mk.columns else "marker"
        celltype_col = "cell_type" if "cell_type" in mk.columns else None
        if celltype_col is not None and symbol_col in mk.columns:
            grouped = mk.groupby(celltype_col)
            for ct, df_ct in grouped:
                # require minimal evidence count per cell_type
                if df_ct.shape[0] < 2:
                    continue
                genes = [str(x) for x in df_ct[symbol_col].tolist()]
                genes = map_symbols_alias(genes, alias_to_canonical)
                sets.append({
                    "name": f"marker:{ct}",
                    "source": "Marker",
                    "type": "marker",
                    "description": f"Markers aggregated for cell type {ct}",
                    "genes": genes
                })

    return sets


def load_regulon_sets(nest_path: str, alias_to_canonical: Dict[str, str]) -> List[Dict]:
    sets: List[Dict] = []
    if os.path.exists(nest_path):
        df = pd.read_csv(nest_path, sep="\t")
        for _, row in df.iterrows():
            tf = standardize_symbol(row.get("name_new", ""))
            targets = parse_gene_list(row.get("Genes", ""))
            targets = map_symbols_alias(targets, alias_to_canonical)
            if tf:
                sets.append({
                    "name": f"regulon:{tf}",
                    "source": "Regulon",
                    "type": "regulon",
                    "description": f"NeST TF-target regulon for {tf}",
                    "genes": targets
                })
    return sets


def filter_and_dedup_sets(sets: List[Dict],
                          gene_universe: Set[str],
                          exclude_genes: Set[str],
                          size_min: int = 5,
                          size_max: int = 300,
                          jaccard_thresh: float = 0.8,
                          remove_ubiq_pct: float = 0.02) -> List[Dict]:
    # Intersect with gene universe and exclude undesired genes
    filtered: List[Dict] = []
    for s in sets:
        gs = set([g for g in s["genes"] if (g in gene_universe and g not in exclude_genes)])
        if size_min <= len(gs) <= size_max:
            s2 = s.copy()
            s2["genes_in_data"] = gs
            s2["size_in_data"] = len(gs)
            filtered.append(s2)

    if not filtered:
        return []

    # Compute gene frequency across filtered sets
    freq: Dict[str, int] = {}
    for s in filtered:
        for g in s["genes_in_data"]:
            freq[g] = freq.get(g, 0) + 1
    # Determine ubiquitous genes for dedup only
    uniq_genes = list(freq.keys())
    if len(uniq_genes) > 0 and remove_ubiq_pct > 0:
        k_top = max(1, int(np.ceil(remove_ubiq_pct * len(uniq_genes))))
        top_genes = sorted(uniq_genes, key=lambda x: (-freq[x], x))[:k_top]
        ubiq = set(top_genes)
    else:
        ubiq = set()

    # Priority for sorting (lower is higher priority)
    priority = {"marker": 0, "Marker": 0, "regulon": 0.5, "Regulon": 0.5, "MSigDB": 1, "GO": 2}

    def sort_key(s):
        return (priority.get(s.get("type", s.get("source", "")), 3), -s["size_in_data"])

    filtered.sort(key=sort_key)

    # Attach genes_for_dedup (remove ubiquitous genes for overlap testing only)
    for s in filtered:
        s["genes_for_dedup"] = set([g for g in s["genes_in_data"] if g not in ubiq])

    # Greedy de-duplication within-source, then across sources
    kept_within: List[Dict] = []
    by_source: Dict[str, List[Dict]] = {}
    for s in filtered:
        src = s.get("source", s.get("type", ""))
        by_source.setdefault(src, []).append(s)

    # Within source
    tmp_kept: List[Dict] = []
    for src, lst in by_source.items():
        kept_src: List[Dict] = []
        for s in lst:
            keep = True
            gs = s["genes_for_dedup"]
            for t in kept_src:
                inter = len(gs & t["genes_for_dedup"])
                union = len(gs | t["genes_for_dedup"])
                jacc = inter / union if union > 0 else 0.0
                if jacc > jaccard_thresh:
                    keep = False
                    break
            if keep:
                kept_src.append(s)
        tmp_kept.extend(kept_src)

    tmp_kept.sort(key=sort_key)

    # Across sources
    kept_final: List[Dict] = []
    for s in tmp_kept:
        keep = True
        gs = s["genes_for_dedup"]
        for t in kept_final:
            inter = len(gs & t["genes_for_dedup"])
            union = len(gs | t["genes_for_dedup"])
            jacc = inter / union if union > 0 else 0.0
            if jacc > jaccard_thresh:
                keep = False
                break
        if keep:
            kept_final.append(s)

    # Clean up temp field
    for s in kept_final:
        if "genes_for_dedup" in s:
            del s["genes_for_dedup"]

    return kept_final


def compute_batch_robust_gene_var(adata: ad.AnnData, batch_key: str = "dataset") -> np.ndarray:
    X = adata.X
    if not hasattr(X, "tocoo"):
        X = csr_matrix(X)
    if not isinstance(X, csr_matrix):
        X = X.tocsr()

    cell_sums = np.array(X.sum(axis=1)).flatten()
    scale = 1e4 / np.maximum(cell_sums, 1.0)
    S = diags(scale)
    Xn = S.dot(X).tocsr(copy=True)
    Xn.data = np.log1p(Xn.data)

    batches = adata.obs[batch_key].astype(str) if (batch_key in adata.obs.columns) else pd.Series(["all"] * adata.n_obs)
    vars_per_batch = []
    for b in batches.unique():
        idx = np.where(batches.values == b)[0]
        if idx.size == 0:
            continue
        Xb = Xn[idx, :]
        mean = np.array(Xb.mean(axis=0)).flatten()
        ex2 = np.array(Xb.multiply(Xb).mean(axis=0)).flatten()
        var_b = ex2 - (mean ** 2)
        var_b[var_b < 0] = 0.0
        vars_per_batch.append(var_b)
    if not vars_per_batch:
        mean = np.array(Xn.mean(axis=0)).flatten()
        ex2 = np.array(Xn.multiply(Xn).mean(axis=0)).flatten()
        var_all = ex2 - (mean ** 2)
        var_all[var_all < 0] = 0.0
        return var_all.astype(np.float32)
    var_stack = np.vstack(vars_per_batch)
    var_med = np.median(var_stack, axis=0)
    var_med[var_med < 0] = 0.0
    return var_med.astype(np.float32)


def select_sets_by_ic(sets: List[Dict], gene_index: Dict[str, int], gene_var_prior: np.ndarray,
                      topk_min: int = 800, topk_max: int = 1500) -> List[Dict]:
    # IC = mean(var genes) * log10(size)
    for s in sets:
        idx = [gene_index[g] for g in s["genes_in_data"] if g in gene_index]
        if len(idx) == 0:
            ic = 0.0
        else:
            ic = float(np.mean(gene_var_prior[np.array(idx, dtype=np.int64)])) * (np.log10(len(idx)) if len(idx) > 0 else 0.0)
        s["IC"] = ic

    sets_sorted = sorted(sets, key=lambda x: x["IC"], reverse=True)

    n = len(sets_sorted)
    if n <= topk_min:
        return sets_sorted

    # Prefer dropping the broadest GO terms first
    go_sizes = [s["size_in_data"] for s in sets_sorted if s.get("source", s.get("type", "")) == "GO"]
    if len(go_sizes) > 0:
        thr = np.percentile(np.array(go_sizes, dtype=np.float32), 90.0)
        sets_pruned = [s for s in sets_sorted if not (s.get("source", s.get("type", "")) == "GO" and s["size_in_data"] >= thr)]
        if len(sets_pruned) >= topk_min:
            sets_sorted = sets_pruned

    if len(sets_sorted) > topk_max:
        sets_sorted = sets_sorted[:topk_max]
    return sets_sorted


def build_membership_matrix(selected_sets: List[Dict], symbol_to_index: Dict[str, int]) -> Tuple[csr_matrix, List[str], np.ndarray, Dict[str, int]]:
    gene_freq: Dict[str, int] = {}
    for s in selected_sets:
        for g in s["genes_in_data"]:
            gene_freq[g] = gene_freq.get(g, 0) + 1

    rows = []
    cols = []
    data = []
    for j, s in enumerate(selected_sets):
        for g in s["genes_in_data"]:
            if g in symbol_to_index:
                i = symbol_to_index[g]
                freq = gene_freq.get(g, 1)
                w = 1.0 / np.log(2.0 + float(freq))  # IDF-like
                rows.append(i)
                cols.append(j)
                data.append(w)

    n_genes = len(symbol_to_index)
    n_sets = len(selected_sets)
    M = csr_matrix((np.array(data, dtype=np.float32),
                    (np.array(rows, dtype=np.int64), np.array(cols, dtype=np.int64))),
                   shape=(n_genes, n_sets), dtype=np.float32)

    # Column L2 normalization to stabilize decoder scales
    col_norms = np.sqrt(np.array(M.power(2).sum(axis=0)).flatten())
    col_norms[col_norms <= 0] = 1.0
    D_inv = diags(1.0 / col_norms.astype(np.float32))
    M = (M @ D_inv).astype(np.float32)

    # Canonicalize CSR
    M.eliminate_zeros()
    M.sort_indices()

    set_ids = [f"S{j}" for j in range(n_sets)]
    return M, set_ids, col_norms.astype(np.float32), gene_freq


def compute_set_weights(selected_sets: List[Dict], set_ids: List[str]) -> Dict[str, float]:
    lambda0 = 1.0
    scale_map = {"marker": 0.5, "Marker": 0.5, "MSigDB": 1.0, "GO": 1.5, "regulon": 1.2, "Regulon": 1.2}
    weights = {}
    for sid, s in zip(set_ids, selected_sets):
        size_s = max(1, s.get("size_in_data", len(s.get("genes_in_data", []))))
        src = s.get("type", s.get("source", "MSigDB"))
        scale = scale_map.get(src, 1.0)
        w = lambda0 * scale / (np.log2(size_s) + 1.0)
        weights[sid] = float(w)
    return weights


def build_regulatory_graph(nest_path: str, gene_symbol_to_index: Dict[str, int]) -> csr_matrix:
    n_genes = len(gene_symbol_to_index)
    if os.path.exists(nest_path):
        df = pd.read_csv(nest_path, sep="\t")
    else:
        df = pd.DataFrame(columns=["name_new", "Genes"])

    rows = []
    cols = []
    for _, row in df.iterrows():
        tf = standardize_symbol(row.get("name_new", ""))
        targets = parse_gene_list(row.get("Genes", ""))
        targets = [standardize_symbol(t) for t in targets]
        if tf in gene_symbol_to_index:
            tf_idx = gene_symbol_to_index[tf]
            for tgt in targets:
                if tgt in gene_symbol_to_index:
                    tgt_idx = gene_symbol_to_index[tgt]
                    rows.extend([tf_idx, tgt_idx])
                    cols.extend([tgt_idx, tf_idx])

    if len(rows) == 0:
        A = csr_matrix((n_genes, n_genes), dtype=np.float32)
    else:
        data = np.ones(len(rows), dtype=np.float32)
        A = csr_matrix((data, (np.array(rows, dtype=np.int64), np.array(cols, dtype=np.int64))),
                       shape=(n_genes, n_genes), dtype=np.float32)
        A.data[:] = 1.0
        A.setdiag(0.0)
        A.eliminate_zeros()

    A = (A + A.T).astype(np.float32)
    A.data[:] = 1.0
    A.setdiag(0.0)
    A.eliminate_zeros()
    A.sort_indices()
    return A


def normalized_laplacian(A: csr_matrix) -> csr_matrix:
    n = A.shape[0]
    deg = np.array(A.sum(axis=1)).flatten()
    with np.errstate(divide="ignore"):
        deg_inv_sqrt = 1.0 / np.sqrt(np.maximum(deg, 0.0))
    deg_inv_sqrt[np.isinf(deg_inv_sqrt)] = 0.0
    D_is = diags(deg_inv_sqrt.astype(np.float32))
    L = eye(n, dtype=np.float32, format="csr") - (D_is @ A @ D_is)
    # Do not force diagonal to 1; zero-out isolated nodes' diagonal to avoid unintended penalties
    iso = np.where(deg == 0)[0]
    if iso.size > 0:
        L = L.tolil()
        L[iso, iso] = 0.0
        L = L.tocsr()
    L.eliminate_zeros()
    L.sort_indices()
    return L.astype(np.float32)


def write_and_assert_csv(df: pd.DataFrame, path: str, required_cols: List[str] = None):
    df.to_csv(path, index=False)
    assert os.path.exists(path), f"CSV not written: {path}"
    df2 = pd.read_csv(path)
    if required_cols is not None:
        for c in required_cols:
            assert c in df2.columns, f"Missing required column {c} in {path}"


def main():
    ensure_dir(PRIOR_OUTPUT_DIR)

    # Load dataset
    adata = ad.read_h5ad(INPUT_MOD1)
    n_cells, n_features = adata.n_obs, adata.n_vars
    dataset_genes = list(map(str, adata.var_names.tolist()))

    # Load meta info
    meta_df = pd.read_csv(META_INFO_PATH) if os.path.exists(META_INFO_PATH) else pd.DataFrame(columns=["gene", "summary_symbol"])
    alias_to_canonical = create_alias_map(meta_df)

    # Build standardized gene list and symbol map
    prior_genes, gene_symbol_map_df, symbol_to_index, mapped_symbols = build_symbol_map(dataset_genes, meta_df)
    n_genes = len(prior_genes)

    # Quick dataset-level expression/variance mappings in dataset order
    # Expression sums (to identify unexpressed non-coding genes)
    X = adata.X
    if not hasattr(X, "tocoo"):
        X = csr_matrix(X)
    if not isinstance(X, csr_matrix):
        X = X.tocsr()
    gene_sums_dataset = np.array(X.sum(axis=0)).flatten()

    # Map dataset indices to canonical symbols
    dataset_std = [standardize_symbol(g) for g in dataset_genes]
    dataset_canonical = [alias_to_canonical.get(s, s) for s in dataset_std]
    canonical_to_dsidxs: Dict[str, List[int]] = {}
    for i, sym in enumerate(dataset_canonical):
        canonical_to_dsidxs.setdefault(sym, []).append(i)

    # Flags for mitochondrial and ribosomal genes
    is_mt = [1 if g.startswith("MT-") else 0 for g in prior_genes]
    is_ribo = [1 if (g.startswith("RPS") or g.startswith("RPL")) else 0 for g in prior_genes]

    # Write prior_genes.csv
    prior_genes_df = pd.DataFrame({
        "standardized_symbol": prior_genes,
        "gene_index": list(range(n_genes)),
        "is_mt": is_mt,
        "is_ribo": is_ribo
    })
    write_and_assert_csv(prior_genes_df, PRIOR_GENES_CSV, required_cols=["standardized_symbol", "gene_index", "is_mt", "is_ribo"])

    # Write gene symbol map
    write_and_assert_csv(gene_symbol_map_df, PRIOR_GENE_SYMBOL_MAP_CSV, required_cols=["original_symbol", "standardized_symbol", "status"])

    # Load gene sets from resources and map aliases
    raw_sets = load_gene_sets(MSIGDB_PATH, GO_PATH, MARKER_PATH, alias_to_canonical)
    # Add regulon-based sets from NeST
    raw_sets.extend(load_regulon_sets(NEST_PATH, alias_to_canonical))

    # Compute batch-robust per-gene variance (dataset order)
    gene_var_dataset = compute_batch_robust_gene_var(adata, batch_key="dataset")

    # Aggregate dataset-order variance to prior_genes order (resolve duplicates by median)
    gene_var_prior = np.zeros(n_genes, dtype=np.float32)
    for j, sym in enumerate(prior_genes):
        idxs = canonical_to_dsidxs.get(sym, [])
        if idxs:
            gene_var_prior[j] = float(np.median(gene_var_dataset[np.array(idxs, dtype=np.int64)]))
        else:
            gene_var_prior[j] = 0.0

    # Build exclude genes set: MT/RPS/RPL plus low-value non-coding unexpressed genes
    exclude_genes: Set[str] = set()
    for g, mt, rb in zip(prior_genes, is_mt, is_ribo):
        if mt == 1 or rb == 1:
            exclude_genes.add(g)

    # Identify non-coding categories from meta_info and drop if unexpressed
    if not meta_df.empty and "summary_type" in meta_df.columns:
        meta = meta_df.copy()
        meta["gene_std"] = meta["gene"].astype(str).map(standardize_symbol) if "gene" in meta.columns else ""
        meta["summary_symbol_std"] = meta["summary_symbol"].astype(str).map(standardize_symbol) if "summary_symbol" in meta.columns else ""
        if "species" in meta.columns:
            meta = meta[meta["species"].astype(str).str.contains("Homo sapiens", case=False, na=False)]
        noncoding_patterns = re.compile(r"pseudogene|linc|lnc|antisense|mirna|sno|snrna|rrna|trna|tec", re.IGNORECASE)
        # Build map for canonical to summary_type
        type_map: Dict[str, str] = {}
        for _, row in meta.iterrows():
            can = row.get("summary_symbol_std", "") or row.get("gene_std", "")
            if can and (can not in type_map):
                type_map[can] = str(row.get("summary_type", ""))
        # Expressed check per canonical (sum over mapped dataset indices)
        expressed_map: Dict[str, bool] = {}
        for can, idxs in canonical_to_dsidxs.items():
            if len(idxs) > 0:
                expressed_map[can] = bool(np.sum(gene_sums_dataset[np.array(idxs, dtype=np.int64)]) > 0)
        for g in prior_genes:
            t = type_map.get(g, "")
            if noncoding_patterns.search(t or "") and not expressed_map.get(g, False):
                exclude_genes.add(g)

    # Filter and de-duplicate sets (initial strict thresholds)
    gene_universe = set(prior_genes)
    size_min, size_max = 5, 300
    jaccard_thresh = 0.8
    filtered_sets = filter_and_dedup_sets(raw_sets, gene_universe, exclude_genes,
                                          size_min=size_min, size_max=size_max,
                                          jaccard_thresh=jaccard_thresh, remove_ubiq_pct=0.02)

    # Adaptive relaxation if too few sets
    if len(filtered_sets) < 800:
        filtered_sets = filter_and_dedup_sets(raw_sets, gene_universe, exclude_genes,
                                              size_min=size_min, size_max=500,
                                              jaccard_thresh=min(0.95, jaccard_thresh + 0.15), remove_ubiq_pct=0.01)
    if len(filtered_sets) < 800:
        filtered_sets = filter_and_dedup_sets(raw_sets, gene_universe, exclude_genes,
                                              size_min=size_min, size_max=700,
                                              jaccard_thresh=0.95, remove_ubiq_pct=0.0)

    # Select sets by IC to target 800–1500
    selected_sets = select_sets_by_ic(filtered_sets, symbol_to_index, gene_var_prior, topk_min=800, topk_max=1500)

    # Build membership matrix with IDF weights + column L2 normalization
    M, set_ids, col_norms, gene_freq = build_membership_matrix(selected_sets, symbol_to_index)
    save_npz(PRIOR_GENE_SET_MEM_NPZ, M)
    assert os.path.exists(PRIOR_GENE_SET_MEM_NPZ), "Missing prior_gene_set_membership.npz"
    M_check = load_npz(PRIOR_GENE_SET_MEM_NPZ)
    assert M_check.shape[0] == n_genes, "Membership n_genes mismatch"
    assert M_check.shape[1] == len(selected_sets), "Membership n_sets mismatch"
    assert str(M_check.dtype) == "float32", "Membership dtype must be float32"

    # Build regulatory adjacency and laplacian
    A = build_regulatory_graph(NEST_PATH, symbol_to_index)
    A.eliminate_zeros(); A.sort_indices()
    save_npz(PRIOR_REG_ADJ_NPZ, A.astype(np.float32))
    assert os.path.exists(PRIOR_REG_ADJ_NPZ), "Missing prior_regulatory_adj.npz"
    A_check = load_npz(PRIOR_REG_ADJ_NPZ)
    assert A_check.shape == (n_genes, n_genes), "Adjacency shape mismatch"
    assert str(A_check.dtype) == "float32", "Adjacency dtype must be float32"

    L = normalized_laplacian(A_check)
    save_npz(PRIOR_REG_LAPL_NPZ, L.astype(np.float32))
    assert os.path.exists(PRIOR_REG_LAPL_NPZ), "Missing prior_regulatory_laplacian.npz"
    L_check = load_npz(PRIOR_REG_LAPL_NPZ)
    assert L_check.shape == (n_genes, n_genes), "Laplacian shape mismatch"
    assert str(L_check.dtype) == "float32", "Laplacian dtype must be float32"

    # Compute per-set weights
    set_weights = compute_set_weights(selected_sets, set_ids)
    with open(PRIOR_SET_WEIGHTS_JSON, "w") as f:
        json.dump(set_weights, f, indent=2)
    assert os.path.exists(PRIOR_SET_WEIGHTS_JSON), "Missing prior_set_weights.json"
    with open(PRIOR_SET_WEIGHTS_JSON, "r") as f:
        sw = json.load(f)
    assert isinstance(sw, dict) and len(sw) == len(set_ids), "Set weights dict mismatch"

    # Prepare gene set metadata with IC in [0,1] and membership column norms
    ICs = np.array([s.get("IC", 0.0) for s in selected_sets], dtype=np.float32)
    if len(ICs) > 0:
        IC_min = float(np.min(ICs))
        IC_max = float(np.max(ICs))
        denom = (IC_max - IC_min) if (IC_max - IC_min) > 1e-8 else 1.0
        IC_norm = (ICs - IC_min) / denom
    else:
        IC_norm = np.array([], dtype=np.float32)

    meta_records = []
    for j, (sid, s) in enumerate(zip(set_ids, selected_sets)):
        meta_records.append({
            "set_id": sid,
            "name": s.get("name", sid),
            "source": s.get("source", s.get("type", "")),
            "type": s.get("type", s.get("source", "")),
            "size_in_data": int(s.get("size_in_data", len(s.get("genes_in_data", [])))),
            "description": s.get("description", ""),
            "weight_init": float(IC_norm[j]) if len(IC_norm) > j else 0.0,
            "membership_col_l2_norm": float(col_norms[j]) if len(col_norms) > j else 1.0
        })
    sets_meta_df = pd.DataFrame(meta_records)
    write_and_assert_csv(sets_meta_df, PRIOR_GENE_SETS_META_CSV,
                         required_cols=["set_id", "name", "source", "type", "size_in_data", "description", "weight_init"])

    # Summary and provenance
    n_sets_raw = len(raw_sets)
    n_sets_filtered = len(filtered_sets)
    n_sets_selected = len(selected_sets)

    covered_genes = set()
    for s in selected_sets:
        covered_genes |= s["genes_in_data"]
    coverage_pct = 100.0 * (len(covered_genes) / max(1, n_genes))

    # Regulatory edges count (undirected)
    A_bin = A_check.copy()
    if A_bin.nnz > 0:
        A_bin.data[:] = 1.0
    edges_undirected = int(A_bin.nnz // 2)

    # Gene frequency top list for diagnostics
    top_gene_freq = sorted(gene_freq.items(), key=lambda x: (-x[1], x[0]))[:20]

    summary = {
        "dataset": {
            "n_cells": int(n_cells),
            "n_genes_dataset": int(n_features),
            "n_genes_prior": int(n_genes)
        },
        "prior_resources": {
            "MsigDB_path": MSIGDB_PATH,
            "GO_terms_path": GO_PATH,
            "Cell_marker_Human_path": MARKER_PATH,
            "NeST_path": NEST_PATH,
            "meta_info_path": META_INFO_PATH
        },
        "thresholds": {
            "size_min": size_min,
            "size_max": size_max,
            "jaccard_threshold": jaccard_thresh,
            "topk_min": 800,
            "topk_max": 1500
        },
        "gene_sets": {
            "n_sets_raw": int(n_sets_raw),
            "n_sets_after_size_filter": int(n_sets_filtered),
            "n_sets_selected": int(n_sets_selected),
            "coverage_genes_in_selected_pct": float(coverage_pct)
        },
        "regulatory_graph": {
            "n_edges_undirected": int(edges_undirected),
            "adjacency_path": PRIOR_REG_ADJ_NPZ,
            "laplacian_path": PRIOR_REG_LAPL_NPZ
        },
        "artifacts": {
            "prior_genes_csv": PRIOR_GENES_CSV,
            "prior_gene_symbol_map_csv": PRIOR_GENE_SYMBOL_MAP_CSV,
            "prior_gene_set_membership_npz": PRIOR_GENE_SET_MEM_NPZ,
            "prior_gene_sets_metadata_csv": PRIOR_GENE_SETS_META_CSV,
            "prior_set_weights_json": PRIOR_SET_WEIGHTS_JSON,
            "prior_summary_json": PRIOR_SUMMARY_JSON
        },
        "stats": {
            "top_genes_by_set_frequency": top_gene_freq
        }
    }
    with open(PRIOR_SUMMARY_JSON, "w") as f:
        json.dump(summary, f, indent=2)
    assert os.path.exists(PRIOR_SUMMARY_JSON), "Missing prior_summary.json"
    with open(PRIOR_SUMMARY_JSON, "r") as f:
        _ = json.load(f)

    # Final assertions of consistency
    M_loaded = load_npz(PRIOR_GENE_SET_MEM_NPZ)
    meta_loaded = pd.read_csv(PRIOR_GENE_SETS_META_CSV)
    with open(PRIOR_SET_WEIGHTS_JSON, "r") as f:
        weights_loaded = json.load(f)
    assert M_loaded.shape[1] == meta_loaded.shape[0], "Mismatch between membership n_sets and metadata rows"
    assert M_loaded.shape[1] == len(weights_loaded), "Mismatch between membership n_sets and set_weights entries"
    prior_genes_loaded = pd.read_csv(PRIOR_GENES_CSV)
    assert M_loaded.shape[0] == prior_genes_loaded.shape[0], "Mismatch between membership n_genes and prior_genes rows"
    A_loaded = load_npz(PRIOR_REG_ADJ_NPZ)
    L_loaded = load_npz(PRIOR_REG_LAPL_NPZ)
    assert A_loaded.shape == (prior_genes_loaded.shape[0], prior_genes_loaded.shape[0]), "Adjacency shape mismatch with prior_genes"
    assert L_loaded.shape == (prior_genes_loaded.shape[0], prior_genes_loaded.shape[0]), "Laplacian shape mismatch with prior_genes"


if __name__ == "__main__":
    main()
