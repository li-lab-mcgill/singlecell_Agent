    "decorrelation_gamma": 1e-3,  # apply to z_free only
    "cross_decorrelation_gamma": 0.0,  # optional cross-cov z_prior vs z_free
    "dataset_bias_l2": 1e-4,
    "prior_nonneg_penalty": 1e-4,
    "prior_colnorm_penalty": 1e-4,
    "orthogonality_penalty": 1e-4,
