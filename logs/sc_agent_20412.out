        json.dump(training_logs, f, indent=2, cls=NpEncoder)

    # Pipeline summary
    pipeline_summary = {
        "inputs": {"input_mod1": INPUT_MOD1, "prior_dir": PRIOR_DIR},
        "preprocess_outputs": {
            "preprocess_metadata": OUT_PREPROCESS_METADATA,
            "train_h5ad": OUT_TRAIN,
