# Constants
RANDOM_STATE = 42
TARGET_SUM = 1e4
HVG_TOP_N = 3000
MODEL_GENE_CAP = 7000
SET_MIN_SIZE = 5
SET_MAX_KEEP = 1500
SET_MIN_TARGET = 800  # informational
MIN_PER_SET_COVERAGE = 5  # guarantee per-set coverage when capping
