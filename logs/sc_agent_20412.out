import json
import warnings
from typing import Dict, List, Tuple

import numpy as np
import pandas as pd
import scipy.sparse as sp
from scipy.io import mmread
from scipy import sparse
import scipy
import anndata as ad
import scanpy as sc

warnings.filterwarnings("ignore", category=FutureWarning)

class NpEncoder(json.JSONEncoder):
    def default(self, obj):
        if isinstance(obj, np.integer):
            return int(obj)
        if isinstance(obj, np.floating):
            return float(obj)
        if isinstance(obj, np.bool_):
            return bool(obj)
        if isinstance(obj, np.ndarray):
            return obj.tolist()
        return super().default(obj)

# Fixed paths (do not change)
INPUT_MOD1 = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/RNA_count.h5ad"
PRIOR_DIR = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/prior"

OUT_PREPROCESS_METADATA = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/preprocess_metadata.json"
OUT_TRAIN = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/preprocess_train_mod1.h5ad"
OUT_VAL = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/preprocess_val_mod1.h5ad"
OUT_TEST = "/home/mcb/users/ekourb/singlecell_Agent/runsv2/results/intermediate_output/step_0/preprocess_test_mod1.h5ad"

# Constants
RANDOM_STATE = 42
TARGET_SUM = 1e4
HVG_TOP_N = 3000
MODEL_GENE_CAP = 7000
SET_MIN_SIZE = 5
SET_MAX_KEEP = 1500
SET_MIN_TARGET = 800  # informational; cannot upsample sets, only downselect if too many


def ensure_dir(path: str):
    d = os.path.dirname(path)
    if d and not os.path.exists(d):
        os.makedirs(d, exist_ok=True)


def standardize_symbol(symbol: str) -> str:
    if symbol is None:
        return ""
    s = str(symbol)
    if "." in s:
        s = s.split(".", 1)[0]
    return s.upper()


def compute_cell_qc(adata: ad.AnnData):
    # percent.mt if missing
    if "percent.mt" not in adata.obs.columns:
        mt_mask = adata.var_names.str.upper().str.startswith("MT-")
        # Ensure a boolean indicator column exists in .var for Scanpy
        adata.var["mt"] = np.asarray(mt_mask, dtype=bool)
        sc.pp.calculate_qc_metrics(adata, qc_vars=["mt"], inplace=True)
        if "pct_counts_mt" in adata.obs.columns:
            adata.obs["percent.mt"] = adata.obs["pct_counts_mt"]
        else:
            # Fallback manual
            X = adata.X
            if sp.issparse(X):
                mt_counts = np.array(X[:, adata.var["mt"].values].sum(axis=1)).ravel()
                total_counts = np.array(X.sum(axis=1)).ravel()
            else:
                mt_counts = X[:, adata.var["mt"].values].sum(axis=1)
                total_counts = X.sum(axis=1)
            pct = np.zeros_like(total_counts, dtype=np.float64)
            nonzero = total_counts > 0
            pct[nonzero] = (mt_counts[nonzero] / total_counts[nonzero]) * 100.0
            adata.obs["percent.mt"] = pct

    # nCount_RNA, nFeature_RNA if missing
    need_counts = ("nCount_RNA" not in adata.obs.columns) or ("nFeature_RNA" not in adata.obs.columns)
    if need_counts:
        sc.pp.calculate_qc_metrics(adata, inplace=True)
        if "total_counts" in adata.obs.columns and "n_genes_by_counts" in adata.obs.columns:
            adata.obs["nCount_RNA"] = adata.obs["total_counts"].astype(np.int64)
            adata.obs["nFeature_RNA"] = adata.obs["n_genes_by_counts"].astype(np.int64)
        else:
            X = adata.X
            if sp.issparse(X):
                total_counts = np.array(X.sum(axis=1)).ravel()
                n_genes = np.array((X > 0).sum(axis=1)).ravel()
            else:
                total_counts = X.sum(axis=1)
                n_genes = (X > 0).sum(axis=1)
            adata.obs["nCount_RNA"] = total_counts.astype(np.int64)
            adata.obs["nFeature_RNA"] = n_genes.astype(np.int64)


def filter_cells(adata: ad.AnnData) -> Tuple[ad.AnnData, Dict[str, int]]:
    qc = {}
    n0 = adata.n_obs

    # thresholds
    low_feat = adata.obs["nFeature_RNA"] < 200
    high_feat = adata.obs["nFeature_RNA"] > 7000
    high_mt = adata.obs["percent.mt"] > 20

    counts = adata.obs["nCount_RNA"].astype(float).values
    q1 = np.quantile(counts, 0.01)
    q99 = np.quantile(counts, 0.99)
    low_cnt = counts < q1
    high_cnt = counts > q99

    remove = low_feat | high_feat | high_mt | low_cnt | high_cnt
    qc["removed_low_features"] = int(low_feat.sum())
    qc["removed_high_features"] = int(high_feat.sum())
    qc["removed_high_mt"] = int(high_mt.sum())
    qc["removed_low_counts"] = int(low_cnt.sum())
    qc["removed_high_counts"] = int(high_cnt.sum())
    qc["removed_total_unique"] = int(remove.sum())

    adata = adata[~remove].copy()
    qc["remaining_cells"] = int(adata.n_obs)
    qc["removed_fraction"] = float(qc["removed_total_unique"] / n0) if n0 > 0 else 0.0
    return adata, qc


def filter_genes_by_detection(adata: ad.AnnData, min_frac: float = 0.005) -> Tuple[ad.AnnData, int]:
    X = adata.X
    if sp.issparse(X):
        detected = np.array((X > 0).sum(axis=0)).ravel()
    else:
        detected = (X > 0).sum(axis=0)
    frac = detected / float(adata.n_obs if adata.n_obs > 0 else 1)
    keep = frac >= min_frac
    removed = int((~keep).sum())
    adata = adata[:, keep].copy()
    return adata, removed


def one_hot_covariates(obs: pd.DataFrame, cols: List[str]) -> Tuple[np.ndarray, List[str]]:
    df = obs.copy()
    for c in cols:
        if c not in df.columns:
            df[c] = "unknown"
        df[c] = df[c].astype(str).replace({"nan": "unknown", "None": "unknown", "": "unknown"})
    dummies = pd.get_dummies(df[cols], prefix=cols, dtype=np.float32)
    return dummies.values.astype(np.float32), list(dummies.columns)


def stratified_split_by_keys(keys: pd.Series, sizes=(0.8, 0.1, 0.1), seed=RANDOM_STATE) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    assert abs(sum(sizes) - 1.0) < 1e-6
    rs = np.random.RandomState(seed)
    train_idx, val_idx, test_idx = [], [], []
    g = keys.groupby(keys, sort=False)
    # Use positional indices to avoid issues with string index labels
    for _, idx_k in g.indices.items():
        idx_k = np.asarray(idx_k, dtype=np.int64)
        rs.shuffle(idx_k)
        n = len(idx_k)
        n_train = int(np.round(sizes[0] * n))
        n_val = int(np.round(sizes[1] * n))
        n_train = min(max(n_train, 1 if n >= 1 else 0), n)
        remain = n - n_train
        n_val = min(max(n_val, 0), remain)
        n_test = n - n_train - n_val
        train_idx.extend(idx_k[:n_train])
        val_idx.extend(idx_k[n_train:n_train + n_val])
        test_idx.extend(idx_k[n_train + n_val:])
    return np.array(train_idx, dtype=np.int64), np.array(val_idx, dtype=np.int64), np.array(test_idx, dtype=np.int64)


def load_priors(prior_dir: str):
    pg = pd.read_csv(os.path.join(prior_dir, "prior_genes.csv"))
    sym_col = "standardized_symbol" if "standardized_symbol" in pg.columns else pg.columns[0]
    pg["standardized_symbol"] = pg[sym_col].astype(str).apply(standardize_symbol)
    if "is_mt" not in pg.columns:
        pg["is_mt"] = pg["standardized_symbol"].str.startswith("MT-")
    if "is_ribo" not in pg.columns:
        pg["is_ribo"] = pg["standardized_symbol"].str.startswith("RPS") | pg["standardized_symbol"].str.startswith("RPL")

    from scipy.sparse import load_npz
    M = load_npz(os.path.join(prior_dir, "prior_gene_set_membership.npz")).tocsr()

    gs_meta = pd.read_csv(os.path.join(prior_dir, "prior_gene_sets_metadata.csv"))
    # Optional fields handling
    if "type" not in gs_meta.columns:
        gs_meta["type"] = "unknown"
    if "source" not in gs_meta.columns:
        gs_meta["source"] = "unknown"
    if "size_in_data" not in gs_meta.columns:
        # Fallback: compute from M
        gs_meta["size_in_data"] = np.array((M > 0).sum(axis=0)).ravel()

    # Laplacian (not used here but validated load)
    from scipy.sparse import load_npz as load_npz2
    L = load_npz2(os.path.join(prior_dir, "prior_regulatory_laplacian.npz")).tocsr()

    # Set weights
    with open(os.path.join(prior_dir, "prior_set_weights.json"), "r") as f:
        set_weights = json.load(f)

    return pg, M, gs_meta, L, set_weights


def select_sets_within_limits(M_sub: sp.csr_matrix, gs_meta: pd.DataFrame, min_size: int = SET_MIN_SIZE, max_keep: int = SET_MAX_KEEP) -> Tuple[np.ndarray, pd.DataFrame]:
    # Drop sets < min_size after intersection
    sizes_after = np.array((M_sub > 0).sum(axis=0)).ravel()
    keep_sz = sizes_after >= min_size
    kept_idx = np.where(keep_sz)[0]
    meta_kept = gs_meta.iloc[kept_idx].copy().reset_index(drop=True)
    # If too many sets, downselect by simple priority
    if len(kept_idx) > max_keep:
        # Priority: marker > MSigDB > GO > others; then by size_in_data desc
        type_weight = meta_kept["type"].astype(str).str.lower().map(
            {"marker": 3, "msigdb": 2, "go": 1}
        ).fillna(0).astype(int)
        source_weight = meta_kept["source"].astype(str).str.lower().map(
            {"marker": 3, "msigdb": 2, "go": 1}
        ).fillna(0).astype(int)
        priority = (type_weight * 2 + source_weight) * 1.0
        meta_kept["_priority"] = priority.values
        # size_in_data may be missing -> fill 0
        if "size_in_data" in meta_kept.columns:
            sid = meta_kept["size_in_data"].fillna(0).astype(float).values
        else:
            sid = sizes_after[kept_idx].astype(float)
        sort_idx = np.lexsort((-sid, -meta_kept["_priority"].values))
        top = sort_idx[:max_keep]
        kept_idx = kept_idx[top]
        meta_kept = meta_kept.iloc[top].reset_index(drop=True)
        meta_kept.drop(columns=["_priority"], errors="ignore", inplace=True)
    return kept_idx, meta_kept


def main():
    np.random.seed(RANDOM_STATE)

    ensure_dir(OUT_PREPROCESS_METADATA)
    ensure_dir(OUT_TRAIN)
    ensure_dir(OUT_VAL)
    ensure_dir(OUT_TEST)

    # Load priors
    pg, M_full, gs_meta_full, L_full, set_weights = load_priors(PRIOR_DIR)
    prior_symbol_to_idx: Dict[str, int] = {s: i for i, s in enumerate(pg["standardized_symbol"].tolist())}

    # Load data
    adata = sc.read_h5ad(INPUT_MOD1)

    # Restrict obs to required fields
    keep_obs_cols = ["domain", "protocol", "dataset", "cell_type"]
    for col in keep_obs_cols:
        if col not in adata.obs.columns:
            adata.obs[col] = "unknown"
    adata.obs = adata.obs[keep_obs_cols].copy()
    adata.obs["cell_id"] = adata.obs_names.astype(str)

    # Cell QC
    compute_cell_qc(adata)
    adata, qc_report = filter_cells(adata)

    # Gene QC: drop genes with detection < 0.5%
    adata, genes_removed_low_det = filter_genes_by_detection(adata, min_frac=0.005)

    # Tag mitochondrial/ribosomal (preliminary, before alignment)
    var_names_std = adata.var_names.str.upper()
    adata.var["is_mt"] = var_names_std.str.startswith("MT-")
    adata.var["is_ribo"] = var_names_std.str.startswith("RPS") | var_names_std.str.startswith("RPL")

    # Standardize symbols and align to priors
    adata.var["symbol_std"] = [standardize_symbol(g) for g in adata.var_names.tolist()]
    matched_prior_idx = []
    matched_dataset_idx = []
    for j, sym in enumerate(adata.var["symbol_std"].tolist()):
        pidx = prior_symbol_to_idx.get(sym, None)
        if pidx is not None:
            matched_prior_idx.append(pidx)
            matched_dataset_idx.append(j)

    # Subset and reorder genes to match prior order
    if len(matched_dataset_idx) == 0:
        raise RuntimeError("No genes matched between dataset and prior gene list after standardization.")

    order = np.argsort(np.array(matched_prior_idx))
    matched_prior_idx_sorted = list(np.array(matched_prior_idx)[order])
    matched_dataset_idx_sorted = list(np.array(matched_dataset_idx)[order])
    adata = adata[:, matched_dataset_idx_sorted].copy()

    # Update var flags from prior (authoritative)
    adata.var["symbol_std"] = [standardize_symbol(g) for g in adata.var_names.tolist()]
    adata.var["prior_index"] = matched_prior_idx_sorted
    prior_flags = pg.iloc[matched_prior_idx_sorted][["is_mt", "is_ribo"]].reset_index(drop=True)
    adata.var["is_mt"] = prior_flags["is_mt"].astype(bool).values
    adata.var["is_ribo"] = prior_flags["is_ribo"].astype(bool).values

    # Save raw counts in layers['counts']
    counts_layer = adata.X.copy()
    if sp.issparse(counts_layer):
        counts_layer = counts_layer.tocsr()
    adata.layers["counts"] = counts_layer

    # Normalize library size to 10k and log1p
    sc.pp.normalize_total(adata, target_sum=TARGET_SUM, inplace=True)
    sc.pp.log1p(adata)
    # Ensure float32
    if sp.issparse(adata.X):
        adata.X = adata.X.asfptype().tocsr().astype(np.float32)
    else:
        adata.X = adata.X.astype(np.float32)

    # HVG per batch (dataset) with safe fallback to avoid skmisc/loess binary issues
    try:
        if "dataset" in adata.obs.columns:
            sc.pp.highly_variable_genes(adata, flavor="seurat_v3", n_top_genes=HVG_TOP_N, batch_key="dataset", inplace=True)
        else:
            sc.pp.highly_variable_genes(adata, flavor="seurat_v3", n_top_genes=HVG_TOP_N, inplace=True)
    except Exception:
        if "dataset" in adata.obs.columns:
            sc.pp.highly_variable_genes(adata, flavor="seurat", n_top_genes=HVG_TOP_N, batch_key="dataset", inplace=True)
        else:
            sc.pp.highly_variable_genes(adata, flavor="seurat", n_top_genes=HVG_TOP_N, inplace=True)

    hvgs = adata.var["highly_variable"].astype(bool).values if "highly_variable" in adata.var.columns else np.zeros(adata.n_vars, dtype=bool)

    # Align membership matrix to matched genes (rows) in current order
    M_matched = M_full[matched_prior_idx_sorted, :].tocsr()

    # Determine genes covered by any prior set
    gene_in_prior = np.array(M_matched.getnnz(axis=1)).ravel() > 0

    # Final gene set for modeling: (HVG ∪ prior-covered) \ {MT,RPS/RPL}
    exclude = (adata.var["is_mt"].values | adata.var["is_ribo"].values)
    used_in_model = (hvgs | gene_in_prior) & (~exclude)

    # Cap at MODEL_GENE_CAP by prioritizing HVGs and genes with more prior sets, then mean expr
    num_used = int(used_in_model.sum())
    if num_used > MODEL_GENE_CAP:
        prior_set_counts = np.array(M_matched.getnnz(axis=1)).ravel()
        mean_expr = np.array(adata.X.mean(axis=0)).ravel() if not sp.issparse(adata.X) else np.array(adata.X.mean(axis=0)).ravel()
        idx_all = np.arange(adata.n_vars)
        cand = idx_all[used_in_model]
        # Build ranking: HVG (1) first, then prior_set_counts desc, then mean_expr desc
        hvg_flag = hvgs[cand].astype(int)
        sort_keys = np.lexsort((-mean_expr[cand], -prior_set_counts[cand], -hvg_flag))  # ascending indices -> keys negative for descending
        top_idx = cand[sort_keys[:MODEL_GENE_CAP]]
        new_used = np.zeros_like(used_in_model, dtype=bool)
        new_used[top_idx] = True
        used_in_model = new_used
        num_used = int(used_in_model.sum())

    adata.var["used_in_model"] = used_in_model

    # Update membership to used genes and drop small sets
    M_used = M_matched[used_in_model, :].tocsr()
    kept_sets_idx, gs_meta_kept = select_sets_within_limits(M_used, gs_meta_full, min_size=SET_MIN_SIZE, max_keep=SET_MAX_KEEP)
    M_final = M_used[:, kept_sets_idx].tocsr()

    # Covariates: one-hot domain/protocol/dataset
    cov_cols = ["domain", "protocol", "dataset"]
    cov_mat, cov_names = one_hot_covariates(adata.obs, cov_cols)
    adata.obsm["covariates"] = cov_mat.astype(np.float32)
    adata.uns["covariate_columns"] = cov_names

    # Splits: stratified by dataset+protocol
    keys = (adata.obs.get("dataset", pd.Series(["unknown"] * adata.n_obs, index=adata.obs_names)).astype(str) + "||" +
            adata.obs.get("protocol", pd.Series(["unknown"] * adata.n_obs, index=adata.obs_names)).astype(str))
    tr_idx, va_idx, te_idx = stratified_split_by_keys(keys, sizes=(0.8, 0.1, 0.1), seed=RANDOM_STATE)
    split_arr = np.array(["train"] * adata.n_obs, dtype=object)
    split_arr[:] = "train"
    split_arr[va_idx] = "val"
    split_arr[te_idx] = "test"
    adata.obs["split"] = pd.Categorical(split_arr, categories=["train", "val", "test"])

    # Prepare outputs: train/val/test
    adata_train = adata[adata.obs["split"] == "train"].copy()
    adata_val = adata[adata.obs["split"] == "val"].copy()
    adata_test = adata[adata.obs["split"] == "test"].copy()

    # Write outputs
    adata_train.write_h5ad(OUT_TRAIN)
    adata_val.write_h5ad(OUT_VAL)
    adata_test.write_h5ad(OUT_TEST)

    # Assertions for saved h5ad
    for pth, adx in [(OUT_TRAIN, adata_train), (OUT_VAL, adata_val), (OUT_TEST, adata_test)]:
        assert os.path.exists(pth), f"Missing output: {pth}"
        rd = sc.read_h5ad(pth)
        # shapes
        assert rd.n_vars == adata.n_vars, f"Gene dimension mismatch in {pth}"
        # counts layer presence
        has_counts = ("counts" in rd.layers) and (rd.layers["counts"] is not None)
        assert has_counts, f"counts layer missing in {pth}"
        assert "used_in_model" in rd.var.columns and rd.var["used_in_model"].dtype == bool, f"used_in_model invalid in {pth}"
        assert "split" in rd.obs.columns, f"split missing in {pth}"
        assert "covariates" in rd.obsm_keys(), f"covariates missing in {pth}"
        cov = rd.obsm["covariates"]
        assert cov.shape[0] == rd.n_obs and cov.dtype == np.float32, f"covariates shape/dtype invalid in {pth}"
        # X dtype
        if sp.issparse(rd.X):
            assert rd.X.dtype == np.float32, f"X dtype should be float32 in {pth}"
        else:
            assert rd.X.dtype == np.float32, f"X dtype should be float32 in {pth}"
        # counts layer shape
        cnt = rd.layers["counts"]
        if sp.issparse(cnt):
            assert cnt.shape == rd.X.shape, f"counts layer shape mismatch in {pth}"
        else:
            assert cnt.shape == rd.X.shape, f"counts layer shape mismatch in {pth}"

    # Build preprocess metadata
    prior_gene_indices = matched_prior_idx_sorted  # order matches adata.var
    model_gene_indices = np.where(adata.var["used_in_model"].values)[0].tolist()
    split_indices = {
        "train": np.where(adata.obs["split"].values == "train")[0].tolist(),
        "val": np.where(adata.obs["split"].values == "val")[0].tolist(),
        "test": np.where(adata.obs["split"].values == "test")[0].tolist(),
    }
    coverage_stats = {
        "n_genes_total_after_alignment": int(adata.n_vars),
        "n_genes_used_in_model": int(adata.var["used_in_model"].sum()),
        "n_hvgs": int(hvgs.sum()),
        "n_prior_covered_genes": int(gene_in_prior.sum()),
        "n_sets_before": int(M_full.shape[1]),
        "n_sets_after_gene_filter": int(M_matched.shape[1]),
        "n_sets_after_used_genes": int(M_used.shape[1]),
        "n_sets_final_kept": int(len(kept_sets_idx)),
        "set_min_size": int(SET_MIN_SIZE),
        "set_max_keep": int(SET_MAX_KEEP),
    }

    lib_versions = {
        "numpy": np.__version__,
        "pandas": pd.__version__,
        "scipy": scipy.__version__,
        "anndata": ad.__version__,
        "scanpy": sc.__version__,
    }

    preprocess_metadata = {
        "random_state": RANDOM_STATE,
        "input_path": INPUT_MOD1,
        "prior_dir": PRIOR_DIR,
        "n_cells_total": int(adata.n_obs),
        "n_genes_total_after_alignment": int(adata.n_vars),
        "model_gene_cap": MODEL_GENE_CAP,
        "qc_report": qc_report,
        "genes_removed_low_detection": int(genes_removed_low_det),
        "prior_gene_indices_in_order": prior_gene_indices,
        "model_gene_indices": model_gene_indices,
        "kept_set_indices": np.array(kept_sets_idx, dtype=int).tolist(),
        "split_indices": split_indices,
        "covariate_columns": adata.uns.get("covariate_columns", []),
        "coverage_stats": coverage_stats,
        "library_versions": lib_versions,
    }

    with open(OUT_PREPROCESS_METADATA, "w") as f:
        json.dump(preprocess_metadata, f, indent=2, cls=NpEncoder)

    # Assertions for metadata
    assert os.path.exists(OUT_PREPROCESS_METADATA), "preprocess_metadata.json not found"
    with open(OUT_PREPROCESS_METADATA, "r") as f:
        md = json.load(f)
    for k in ["model_gene_indices", "kept_set_indices", "split_indices", "coverage_stats"]:
        assert k in md, f"Missing key {k} in preprocess_metadata.json"
    assert isinstance(md["model_gene_indices"], list), "model_gene_indices should be a list"
    assert isinstance(md["split_indices"]["train"], list), "split_indices.train should be a list"
    assert md["coverage_stats"]["n_genes_used_in_model"] <= MODEL_GENE_CAP, "Model genes exceed cap"

    # Done
    return


if __name__ == "__main__":
    main() </VARIABLE>

