def write_failure_artifacts(err_msg: str):
    # Create minimal valid artifacts on failure to satisfy downstream checks
    for p in [
        MODEL_PERFORMANCE, BEST_MODEL, EMBEDDING, EMBEDDING_METADATA, TRAINING_LOGS,
        PIPELINE_SUMMARY, CLUSTER_ASSIGNMENTS, CLUSTER_METRICS, CLUSTER_SUMMARY, UMAP_PLOT,
        SET_ACTIVITY_TRAIN, SET_ACTIVITY_VAL, SET_ACTIVITY_TEST, SET_META_COPY
    ]:
        ensure_dir(p)
    # best model placeholder
    try:
        torch.save({"error": err_msg}, BEST_MODEL)
        # Mirror best_model to step_2 as well
        try:
            alt_bm = BEST_MODEL.replace("/step_0/", "/step_2/")
            if alt_bm != BEST_MODEL:
                ensure_dir(alt_bm)
                copyfile(BEST_MODEL, alt_bm)
        except Exception:
            pass
        # Mirror best_model to step_3 as well
        try:
            alt_bm3 = BEST_MODEL.replace("/step_0/", "/step_3/")
            if alt_bm3 != BEST_MODEL:
                ensure_dir(alt_bm3)
                copyfile(BEST_MODEL, alt_bm3)
        except Exception:
            pass
    except Exception:
        pass
    # embedding placeholder
    np.save(EMBEDDING, np.zeros((0, 32), dtype=np.float32))
    # Mirror embedding placeholder to step_2 as well
    try:
        alt_emb = EMBEDDING.replace("/step_0/", "/step_2/")
        if alt_emb != EMBEDDING:
            ensure_dir(alt_emb)
            copyfile(EMBEDDING, alt_emb)
    except Exception:
        pass
    # Mirror embedding placeholder to step_3 as well
    try:
        alt_emb3 = EMBEDDING.replace("/step_0/", "/step_3/")
        if alt_emb3 != EMBEDDING:
            ensure_dir(alt_emb3)
            copyfile(EMBEDDING, alt_emb3)
    except Exception:
        pass
    # embedding metadata placeholder
    pd.DataFrame({"cell_id": [], "split": [], "row_index": [], "cell_type": [], "batch": []}).to_csv(EMBEDDING_METADATA, index=False)
    # Mirror embedding metadata placeholder to step_2 as well
    try:
        alt_emd = EMBEDDING_METADATA.replace("/step_0/", "/step_2/")
        if alt_emd != EMBEDDING_METADATA:
            ensure_dir(alt_emd)
            copyfile(EMBEDDING_METADATA, alt_emd)
    except Exception:
        pass
    # Mirror embedding metadata placeholder to step_3 as well
    try:
        alt_emd3 = EMBEDDING_METADATA.replace("/step_0/", "/step_3/")
        if alt_emd3 != EMBEDDING_METADATA:
            ensure_dir(alt_emd3)
            copyfile(EMBEDDING_METADATA, alt_emd3)
    except Exception:
        pass
    # set activities placeholder
    np.save(SET_ACTIVITY_TRAIN, np.zeros((0, 0), dtype=np.float32))
    np.save(SET_ACTIVITY_VAL, np.zeros((0, 0), dtype=np.float32))
    np.save(SET_ACTIVITY_TEST, np.zeros((0, 0), dtype=np.float32))
    # set meta placeholder
    pd.DataFrame({"name": []}).to_csv(SET_META_COPY, index=False)
    # cluster assignments placeholder
    pd.DataFrame({"cell_id": [], "predicted_cluster": [], "split": []}).to_csv(CLUSTER_ASSIGNMENTS, index=False)
    # cluster metrics placeholder
    with open(CLUSTER_METRICS, "w") as f:
        json.dump({"ari": 0.0}, f, indent=2)
    # cluster summary placeholder
    with open(CLUSTER_SUMMARY, "w") as f:
        json.dump([], f, indent=2)
    # training logs with error
    with open(TRAINING_LOGS, "w") as f:
        json.dump([{"error": err_msg}], f, indent=2)
    # Mirror training_logs to step_2 as well
    try:
        alt_tl = TRAINING_LOGS.replace("/step_0/", "/step_2/")
        if alt_tl != TRAINING_LOGS:
            ensure_dir(alt_tl)
            copyfile(TRAINING_LOGS, alt_tl)
    except Exception:
        pass
    # Mirror training_logs to step_3 as well
    try:
        alt_tl3 = TRAINING_LOGS.replace("/step_0/", "/step_3/")
        if alt_tl3 != TRAINING_LOGS:
            ensure_dir(alt_tl3)
            copyfile(TRAINING_LOGS, alt_tl3)
    except Exception:
        pass
    # model performance with error
    with open(MODEL_PERFORMANCE, "w") as f:
        json.dump({
            "best_epoch": -1,
            "val_objective": None,
            "ari": 0.0,
            "train_time_sec": 0.0,
            "k_opt": 0,
            "chosen_checkpoint": None,
            "val_silhouette_chosen": None,
            "error": err_msg
        }, f, indent=2)
    # also mirror model_performance for downstream robustness
    try:
        alt_mp = MODEL_PERFORMANCE.replace("/step_0/", "/step_2/")
        if alt_mp != MODEL_PERFORMANCE:
            ensure_dir(alt_mp)
            with open(MODEL_PERFORMANCE, "r") as f:
                mp_data = json.load(f)
            with open(alt_mp, "w") as f:
                json.dump(mp_data, f, indent=2)
    except Exception:
        pass
    # also mirror model_performance to step_3 for downstream robustness
    try:
        alt_mp3 = MODEL_PERFORMANCE.replace("/step_0/", "/step_3/")
        if alt_mp3 != MODEL_PERFORMANCE:
            ensure_dir(alt_mp3)
            with open(MODEL_PERFORMANCE, "r") as f:
                mp_data3 = json.load(f)
            with open(alt_mp3, "w") as f:
                json.dump(mp_data3, f, indent=2)
    except Exception:
        pass
    # pipeline summary with error
    with open(PIPELINE_SUMMARY, "w") as f:
        json.dump({
            "paths": {
                "input_mod1": INPUT_MOD1,
                "prior_output_dir": PRIOR_OUTPUT_DIR,
                "preprocess_train_mod1": PREPROCESS_TRAIN_MOD1,
                "preprocess_val_mod1": PREPROCESS_VAL_MOD1,
                "preprocess_test_mod1": PREPROCESS_TEST_MOD1,
                "model_performance": MODEL_PERFORMANCE,
                "best_model": BEST_MODEL,
                "embedding": EMBEDDING,
                "embedding_metadata": EMBEDDING_METADATA,
                "training_logs": TRAINING_LOGS,
                "pipeline_summary": PIPELINE_SUMMARY,
                "cluster_assignments": CLUSTER_ASSIGNMENTS,
                "cluster_metrics": CLUSTER_METRICS,
                "cluster_summary": CLUSTER_SUMMARY,
                "umap_plot": UMAP_PLOT,
                "set_activity_train": SET_ACTIVITY_TRAIN,
                "set_activity_val": SET_ACTIVITY_VAL,
                "set_activity_test": SET_ACTIVITY_TEST,
                "set_meta": SET_META_COPY
            },
            "error": err_msg
        }, f, indent=2)
    # Mirror pipeline_summary to step_2 as well
    try:
        alt_ps = PIPELINE_SUMMARY.replace("/step_0/", "/step_2/")
        if alt_ps != PIPELINE_SUMMARY:
            ensure_dir(alt_ps)
            with open(PIPELINE_SUMMARY, "r") as f:
                ps_data = json.load(f)
            with open(alt_ps, "w") as f:
                json.dump(ps_data, f, indent=2)
    except Exception:
        pass
    # Mirror pipeline_summary to step_3 as well
    try:
        alt_ps3 = PIPELINE_SUMMARY.replace("/step_0/", "/step_3/")
        if alt_ps3 != PIPELINE_SUMMARY:
            ensure_dir(alt_ps3)
            with open(PIPELINE_SUMMARY, "r") as f:
                ps_data3 = json.load(f)
            with open(alt_ps3, "w") as f:
                json.dump(ps_data3, f, indent=2)
    except Exception:
        pass
    # umap plot placeholder
    try:
        plt.figure(figsize=(4, 3), dpi=120)
        plt.text(0.5, 0.5, "Training failed.\nSee logs.", ha="center", va="center")
        plt.axis("off")
        plt.tight_layout()
        plt.savefig(UMAP_PLOT)
        plt.close()
    except Exception:
        pass


def main():
    # Ensure output directories exist
    for p in [
        MODEL_PERFORMANCE, BEST_MODEL, EMBEDDING, EMBEDDING_METADATA, TRAINING_LOGS,
        PIPELINE_SUMMARY, CLUSTER_ASSIGNMENTS, CLUSTER_METRICS, CLUSTER_SUMMARY, UMAP_PLOT,
        SET_ACTIVITY_TRAIN, SET_ACTIVITY_VAL, SET_ACTIVITY_TEST, SET_META_COPY
    ]:
        ensure_dir(p)
    try:
        train_model()
    except Exception as e:
        err_msg = f"{type(e).__name__}: {str(e)}\n{traceback.format_exc()}"
        write_failure_artifacts(err_msg)


if __name__ == "__main__":
    main()
