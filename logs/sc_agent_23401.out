NEXT_PRIOR_DIR = os.path.join(IO_ROOT, "step_1", "prior")
NEXT_PRIOR_DIRS = [
    os.path.join(IO_ROOT, "step_1", "prior"),
    os.path.join(IO_ROOT, "step_2", "prior"),
    os.path.join(IO_ROOT, "step_3", "prior"),
]

GENE_VOCAB_CSV = os.path.join(PRIOR_OUTPUT_DIR, "gene_vocab.csv")
