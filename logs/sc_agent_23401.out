def main():
    # Ensure output directories exist
    for p in [
        MODEL_PERFORMANCE, BEST_MODEL, EMBEDDING, EMBEDDING_METADATA, TRAINING_LOGS,
        PIPELINE_SUMMARY, CLUSTER_ASSIGNMENTS, CLUSTER_METRICS, CLUSTER_SUMMARY, UMAP_PLOT,
        SET_ACTIVITY_TRAIN, SET_ACTIVITY_VAL, SET_ACTIVITY_TEST, SET_META_COPY
