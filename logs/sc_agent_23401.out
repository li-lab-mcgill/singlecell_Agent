SET_ACTIVITY_VAL = "/home/mcb/users/ekourb/singlecell_Agent/runsv3/results/intermediate_output/step_1/set_activity_val.npy"
SET_ACTIVITY_TEST = "/home/mcb/users/ekourb/singlecell_Agent/runsv3/results/intermediate_output/step_1/set_activity_test.npy"
