def main():
    # Ensure output directories exist
    for p in [
        MODEL_PERFORMANCE, BEST_MODEL, EMBEDDING, EMBEDDING_METADATA, TRAINING_LOGS,
        PIPELINE_SUMMARY, CLUSTER_ASSIGNMENTS, CLUSTER_METRICS, CLUSTER_SUMMARY, UMAP_PLOT,
        SET_ACTIVITY_TRAIN, SET_ACTIVITY_VAL, SET_ACTIVITY_TEST, SET_META_COPY,
        MODEL_TRAIN_LOGS, SET_ACTIVITY_PRIOR_TRAIN, SET_ACTIVITY_PRIOR_VAL, SET_ACTIVITY_PRIOR_TEST
    ]:
        ensure_dir(p)
    try:
        train_model()
    except Exception as e:
        err_msg = f"{type(e).__name__}: {str(e)}\n{traceback.format_exc()}"
        write_failure_artifacts(err_msg)


if __name__ == "__main__":
    main()</IMPROVED_VARIABLE>
