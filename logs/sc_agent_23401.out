import os
import json
import math
import warnings
import numpy as np
import pandas as pd
import scipy.sparse as sp
from scipy.stats import mannwhitneyu
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.neighbors import NearestNeighbors
from sklearn.decomposition import PCA
from sklearn.metrics import adjusted_rand_score, silhouette_score, silhouette_samples
from numpy.linalg import norm

warnings.filterwarnings("ignore", category=UserWarning)
np.random.seed(42)

# Fixed config-owned artifact paths
BASE = "/home/mcb/users/ekourb/singlecell_Agent/runsv3"
CONFIG = {
    "input_h5ad": f"{BASE}/preprocess/anndata_processed.h5ad",
    "prior_dir": f"{BASE}/priors",
    "model_dir": f"{BASE}/model",
    "embedding_train": f"{BASE}/model/latent_train.npy",
    "embedding_val": f"{BASE}/model/latent_val.npy",
    "embedding_test": f"{BASE}/model/latent_test.npy",
    "set_activity_train": f"{BASE}/model/set_activity_train.npy",
    "set_activity_val": f"{BASE}/model/set_activity_val.npy",
    "set_activity_test": f"{BASE}/model/set_activity_test.npy",
    "set_meta": f"{BASE}/priors/set_meta.csv",
    "set_incidence": f"{BASE}/priors/set_incidence.npz",
    "gene_vocab": f"{BASE}/priors/gene_vocab.csv",
    "cluster_assignments": f"{BASE}/downstream/cluster_assignments.csv",
    "cluster_metrics": f"{BASE}/downstream/cluster_metrics.json",
    "cluster_summary_json": f"{BASE}/downstream/cluster_summary.json",
    "cluster_summary_csv": f"{BASE}/downstream/cluster_summary.csv",
    "umap_plot": f"{BASE}/downstream/umap_plot.png",
    "model_performance": f"{BASE}/model/model_performance.json",
    "train_log": f"{BASE}/model/train_log.json",
}

# Optional dependencies
try:
    import anndata as ad
except Exception:
    ad = None

# Optional plotting
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
except Exception:
    matplotlib = None
    plt = None

def ensure_dirs():
    for k in ["cluster_assignments", "cluster_metrics", "cluster_summary_json", "cluster_summary_csv", "umap_plot"]:
        d = os.path.dirname(CONFIG[k])
        if d:
            os.makedirs(d, exist_ok=True)

def write_dummy_png(path):
    import base64
    png_b64 = 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMB/akS0l4AAAAASUVORK5CYII='
    data = base64.b64decode(png_b64)
    with open(path, 'wb') as f:
        f.write(data)

def bh_fdr(pvals):
    p = np.asarray(pvals, dtype=float)
    m = p.size
    if m == 0:
        return p
    order = np.argsort(p)
    ranked = p[order]
    q = ranked * m / (np.arange(m) + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    q[q > 1] = 1
    out = np.empty_like(q)
    out[order] = q
    return out

def load_sparse_csr(npz_path):
    loader = np.load(npz_path)
    return sp.csr_matrix((loader['data'], loader['indices'], loader['indptr']), shape=loader['shape'])

def row_l2_normalize(X):
    X = np.asarray(X, dtype=float)
    nrm = norm(X, axis=1, keepdims=True)
    nrm[nrm == 0] = 1.0
    return X / nrm

def fast_silhouette(X, labels, metric='euclidean', max_samples=5000, random_state=42):
    n = X.shape[0]
    if len(np.unique(labels)) < 2:
        return -1.0
    if n <= 3000:
        try:
            return float(silhouette_score(X, labels, metric=metric))
        except Exception:
            return -1.0
    rng = np.random.default_rng(random_state)
    idx = rng.choice(n, size=min(max_samples, n), replace=False)
    try:
        return float(silhouette_score(X[idx], np.array(labels)[idx], metric=metric))
    except Exception:
        return -1.0

def asw_batch(X, batch_labels, metric='euclidean'):
    labs = np.asarray(batch_labels).astype(str)
    if len(np.unique(labs)) < 2 or X.shape[0] < 3:
        return 0.0
    try:
        return float(silhouette_score(X, labs, metric=metric))
    except Exception:
        return 0.0

def load_embeddings(adata):
    n = adata.n_obs
    splits = adata.obs['split'].astype(str).values if 'split' in adata.obs.columns else np.array(['all'] * n)
    masks = {
        'train': (splits == 'train'),
        'val': (splits == 'val'),
        'test': (splits == 'test')
    }
    emb = None
    dims = None
    out = np.zeros((n, 1), dtype=float)
    ok = False
    for sp, p in [('train', CONFIG['embedding_train']), ('val', CONFIG['embedding_val']), ('test', CONFIG['embedding_test'])]:
        if os.path.exists(p) and masks[sp].sum() > 0:
            arr = np.load(p)
            if dims is None:
                dims = arr.shape[1]
                out = np.zeros((n, dims), dtype=float)
            if arr.shape[0] == masks[sp].sum():
                out[masks[sp], :] = arr
                ok = True
    if ok:
        return out
    # fallback: try single latent file if provided (not in config, but maintain safety)
    single_path = os.path.join(CONFIG['model_dir'], "latent_all.npy")
    if os.path.exists(single_path):
        arr = np.load(single_path)
        if arr.shape[0] == n:
            return arr
    # last resort: PCA on expression to obtain a placeholder embedding
    X = adata.X.toarray() if sp.issparse(adata.X) else np.asarray(adata.X)
    pca = PCA(n_components=min(32, X.shape[1]), random_state=42)
    return pca.fit_transform(X)

def per_domain_standardize_train_stats(X, domains, mask_anchor):
    X_out = X.copy()
    for d in np.unique(domains):
        idx_all = (domains == d)
        idx_tr = idx_all & mask_anchor
        if np.sum(idx_tr) == 0:
            continue
        mu = X[idx_tr].mean(axis=0)
        sd = X[idx_tr].std(axis=0, ddof=0)
        sd[sd == 0] = 1.0
        X_out[idx_all] = (X[idx_all] - mu) / sd
    return X_out

def build_variants(X, splits, domains):
    mask_anchor = (splits == 'train') | (splits == 'val')
    scaler = StandardScaler(with_mean=True, with_std=True)
    X_std = X.copy()
    if np.sum(mask_anchor) > 0:
        X_std[mask_anchor] = scaler.fit_transform(X[mask_anchor])
        X_std[~mask_anchor] = scaler.transform(X[~mask_anchor])
    else:
        X_std = scaler.fit_transform(X)
    variants = {}
    # global
    variants['global'] = {
        'X_euc': X_std.copy(),
        'X_cos': row_l2_normalize(X_std.copy())
    }
    # per-domain using anchor stats
    try:
        X_dom = per_domain_standardize_train_stats(X_std, domains, mask_anchor)
        variants['domain'] = {
            'X_euc': X_dom.copy(),
            'X_cos': row_l2_normalize(X_dom.copy())
        }
    except Exception:
        pass
    # whitening keeping >=95% var (fit on anchors)
    try:
        Xa = X_std[mask_anchor] if np.sum(mask_anchor) > 0 else X_std
        pca = PCA(whiten=True, random_state=42)
        Z_anchor = pca.fit_transform(Xa)
        if hasattr(pca, "explained_variance_ratio_"):
            csum = np.cumsum(pca.explained_variance_ratio_)
            n_keep = int(np.searchsorted(csum, 0.95) + 1)
            n_keep = max(2, min(n_keep, Z_anchor.shape[1]))
        else:
            n_keep = min(32, Z_anchor.shape[1])
        pca_n = PCA(n_components=n_keep, whiten=True, random_state=42)
        pca_n.fit(Xa)
        Z_all = pca_n.transform(X_std)
        variants['whiten'] = {
            'X_euc': Z_all.copy(),
            'X_cos': row_l2_normalize(Z_all.copy())
        }
    except Exception:
        pass
    return variants

def kmeans_labels(X, k, seed):
    if X.shape[0] < 2 or k < 2:
        return np.array(['0'] * X.shape[0], dtype=str)
    km = KMeans(n_clusters=int(k), random_state=int(seed), n_init=10)
    return km.fit_predict(X).astype(str)

def evaluate_kmeans_stability(X_anchor, domains_anchor, metric, k_list, seeds, alpha=0.2):
    # domain leakage penalty via ASW-batch (independent of clustering)
    asw_b = asw_batch(X_anchor, domains_anchor, metric=metric)
    best = None
    history = []
    for k in sorted(set([int(kk) for kk in k_list if kk >= 2])):
        labels_all = []
        sils = []
        for s in seeds:
            try:
                labs = kmeans_labels(X_anchor, k, s)
                labels_all.append(labs)
                sils.append(fast_silhouette(X_anchor, labs, metric=metric))
            except Exception:
                continue
        if len(labels_all) < 2:
            continue
        # stability
        stab = mean_pairwise_ari(labels_all)
        sil_mean = float(np.mean([ss for ss in sils if np.isfinite(ss)])) if len(sils) > 0 else -1.0
        objective = sil_mean - alpha * asw_b
        rec = {
            'k': int(k),
            'silhouette': float(sil_mean),
            'stability': float(stab),
            'asw_batch': float(asw_b),
            'objective': float(objective),
            'metric': metric
        }
        history.append(rec)
        if (best is None) or (objective > best['objective']) or (math.isclose(objective, best['objective']) and stab > best['stability'])):
            best = rec
    return best, history

def mean_pairwise_ari(label_list):
    k = len(label_list)
    if k < 2:
        return 1.0
    s = 0.0
    n = 0
    for i in range(k):
        for j in range(i + 1, k):
            try:
                s += adjusted_rand_score(label_list[i], label_list[j])
            except Exception:
                continue
            n += 1
    return float(s / max(n, 1))

def recursive_split_anchors(Xa, labs_a, metric='euclidean', max_iter=3, sil_threshold=0.1, min_gain=0.01):
    for _ in range(max_iter):
        if len(np.unique(labs_a)) < 1:
            break
        try:
            s_samples = silhouette_samples(Xa, labs_a, metric=metric)
            current_sil = fast_silhouette(Xa, labs_a, metric=metric)
        except Exception:
            break
        improved = False
        for cl in np.unique(labs_a):
            idx = np.where(labs_a == cl)[0]
            if idx.size < 10:
                continue
            med_sil = np.median(s_samples[idx]) if idx.size > 0 else 0.0
            if med_sil >= sil_threshold:
                continue
            Xa_sub = Xa[idx]
            # try 2-means
            try:
                labs_sub = kmeans_labels(Xa_sub, 2, seed=42)
            except Exception:
                continue
            labs_new = labs_a.copy()
            # relabel within cluster
            # assign unique new labels
            new_labels = [f"{cl}.0", f"{cl}.1"]
            for t, sub_lab in enumerate(np.unique(labs_sub)):
                labs_new[idx[labs_sub == sub_lab]] = new_labels[t]
            new_sil = fast_silhouette(Xa, labs_new, metric=metric)
            if new_sil >= current_sil + min_gain:
                labs_a = labs_new
                improved = True
                break
        if not improved:
            break
    # reindex labels to compact integers as strings
    uniq = np.unique(labs_a)
    mapping = {u: str(i) for i, u in enumerate(uniq)}
    return np.array([mapping[u] for u in labs_a], dtype=str)

def choose_k_and_temperature_for_propagation(Xa, labs_a, metric='euclidean', k_grid=(5,10,15,20,30,40), T_grid=(0.25,0.5,1.0,2.0)):
    # choose k by maximizing neighbor purity on anchors
    if Xa.shape[0] < 3:
        return 5, 1.0
    if metric == 'cosine':
        Xa_use = row_l2_normalize(Xa)
    else:
        Xa_use = Xa
    best_k = None
    best_purity = -1.0
    for k in k_grid:
        k = max(1, min(int(k), Xa_use.shape[0]-1))
        try:
            nn = NearestNeighbors(n_neighbors=k+1, metric=metric).fit(Xa_use)
            dist, idx = nn.kneighbors(Xa_use, return_distance=True)
            idx = idx[:, 1:]  # exclude self
            neigh_labs = np.array(labs_a)[idx]
            same = (neigh_labs == np.array(labs_a)[:, None]).mean(axis=1)
            purity = float(np.mean(same))
            if (purity > best_purity) or (math.isclose(purity, best_purity) and (best_k is None or k < best_k)):
                best_purity = purity
                best_k = int(k)
        except Exception:
            continue
    if best_k is None:
        best_k = 15
    # choose temperature by maximizing soft self-consistency
    best_T = None
    best_score = -1.0
    try:
        nn = NearestNeighbors(n_neighbors=min(best_k+1, Xa_use.shape[0]), metric=metric).fit(Xa_use)
        dist, idx = nn.kneighbors(Xa_use, return_distance=True)
        idx = idx[:, 1:]
        dist = dist[:, 1:]
        for T in T_grid:
            if metric == 'cosine':
                sim = 1.0 - dist
            else:
                sim = 1.0 / (1e-8 + dist)
            w = sim / (T + 1e-8)
            w = np.exp(w - w.max(axis=1, keepdims=True))
            w = w / (w.sum(axis=1, keepdims=True) + 1e-12)
            neigh_labs = np.array(labs_a)[idx]
            uniq = np.unique(labs_a)
            lab_to_col = {lab: i for i, lab in enumerate(uniq)}
            P = np.zeros((Xa_use.shape[0], len(uniq)), dtype=float)
            for i in range(Xa_use.shape[0]):
                for j, lab in enumerate(neigh_labs[i]):
                    P[i, lab_to_col[lab]] += w[i, j]
            pred = np.array([uniq[np.argmax(P[i])] for i in range(Xa_use.shape[0])], dtype=object)
            score = (pred == np.array(labs_a)).mean()
            if score > best_score:
                best_score = float(score)
                best_T = float(T)
    except Exception:
        best_T = 1.0
    if best_T is None:
        best_T = 1.0
    return int(best_k), float(best_T)

def soft_label_propagation(X_anchor, labs_anchor, X_query, metric='euclidean', k=15, temperature=1.0):
    if X_query.shape[0] == 0 or X_anchor.shape[0] == 0:
        return np.array([], dtype=str)
    if metric == 'cosine':
        Xa = row_l2_normalize(X_anchor)
        Xq = row_l2_normalize(X_query)
    else:
        Xa = X_anchor
        Xq = X_query
    k = max(1, min(int(k), Xa.shape[0]))
    nn = NearestNeighbors(n_neighbors=k, metric=metric)
    nn.fit(Xa)
    dist, idx = nn.kneighbors(Xq, return_distance=True)
    if metric == 'cosine':
        sim = 1.0 - dist
    else:
        sim = 1.0 / (1e-8 + dist)
    w = sim / (float(temperature) + 1e-8)
    w = np.exp(w - w.max(axis=1, keepdims=True))
    w = w / (w.sum(axis=1, keepdims=True) + 1e-12)
    uniq = np.unique(labs_anchor)
    lab_to_col = {lab: i for i, lab in enumerate(uniq)}
    P = np.zeros((Xq.shape[0], len(uniq)), dtype=float)
    labs_anchor = np.array(labs_anchor, dtype=object)
    for i in range(Xq.shape[0]):
        for j, ai in enumerate(idx[i]):
            P[i, lab_to_col[labs_anchor[ai]]] += w[i, j]
    pred = np.array([uniq[np.argmax(P[i])] for i in range(Xq.shape[0])], dtype=str)
    return pred

def merge_small_clusters_safe(X_all, labs_all, mask_anchor, metric='cosine'):
    # scale min_size with n
    n = X_all.shape[0]
    min_size = max(15, int(round(0.003 * n)))
    labs = np.array(labs_all, dtype=str)
    uniq, counts = np.unique(labs, return_counts=True)
    small = [u for u, c in zip(uniq, counts) if c < min_size]
    if len(small) == 0:
        return labs
    # compute centroids (use metric geometry)
    def centroid(X):
        c = X.mean(axis=0)
        if metric == 'cosine':
            c = c / (norm(c) + 1e-12)
        return c
    # precompute anchor silhouettes
    try:
        Xa = X_all[mask_anchor]
        la = labs[mask_anchor]
        sil_a = silhouette_samples(Xa, la, metric=metric)
        sil_map = {lab: sil_a[la == lab] for lab in np.unique(la)}
    except Exception:
        sil_map = {lab: np.array([0.0]) for lab in np.unique(labs[mask_anchor])}
    # large clusters
    large = [u for u in uniq if u not in small]
    if len(large) == 0:
        return labs
    centers = {u: centroid(X_all[labs == u]) for u in large}
    for sc in small:
        idx_sc = np.where(labs == sc)[0]
        # require median anchor silhouette non-positive
        med_sil = float(np.median(sil_map.get(sc, np.array([0.0]))))
        if med_sil > 0.0:
            continue
        cen_sc = centroid(X_all[idx_sc])
        # find nearest large by cosine/euclidean distance
        dists = []
        for lg in large:
            cen_lg = centers[lg]
            if metric == 'cosine':
                sim = float(np.dot(cen_sc, cen_lg) / (norm(cen_sc) * norm(cen_lg) + 1e-12))
                d = 1.0 - sim
            else:
                d = float(norm(cen_sc - cen_lg))
            dists.append((d, lg))
        dists.sort(key=lambda x: x[0])
        if len(dists) == 0:
            continue
        d_near, target = dists[0]
        # compute target intra distances to its centroid among anchors
        idx_ta = np.where((labs == target) & mask_anchor)[0]
        if idx_ta.size < 5:
            continue
        cen_t = centers[target]
        if metric == 'cosine':
            sims = (X_all[idx_ta] @ cen_t) / ((norm(X_all[idx_ta], axis=1) * norm(cen_t)) + 1e-12)
            intra = 1.0 - sims
        else:
            intra = norm(X_all[idx_ta] - cen_t, axis=1)
        thr = float(np.percentile(intra, 90))
        # merge only if inter-centroid distance <= threshold
        if d_near <= thr:
            labs[idx_sc] = target
    return labs

def load_prior_artifacts():
    try:
        S = load_sparse_csr(CONFIG['set_incidence'])
        set_meta = pd.read_csv(CONFIG['set_meta'])
        gene_vocab = pd.read_csv(CONFIG['gene_vocab'])
        return S, set_meta, gene_vocab
    except Exception:
        return None, None, None

def compute_deg(ad_all, labs_all, genes_include_mask, gene_vocab):
    # Use per-cell log1p for DE; filter out non-informative genes via gene_vocab
    X = ad_all.layers['log1p'] if 'log1p' in ad_all.layers else (ad_all.X)
    X = X.toarray() if sp.issparse(X) else np.asarray(X)
    var_names = ad_all.var_names.to_numpy().astype(str)
    labs = np.array(labs_all, dtype=str)
    uniq = np.unique(labs)
    # Exclusions
    excl = np.zeros(var_names.shape[0], dtype=bool)
    try:
        gv = gene_vocab.set_index('symbol')
        cols = ['is_mito', 'is_ribo', 'is_housekeeping']
        for c in cols:
            if c in gv.columns:
                m = var_names.astype(object)
                flags = gv.reindex(m)[c].fillna(False).to_numpy().astype(bool)
                excl |= flags
    except Exception:
        pass
    base_mask = (~excl)
    if genes_include_mask is not None:
        base_mask = base_mask & genes_include_mask
    top_degs = {}
    all_sig_degs = {}
    for cl in uniq:
        idx_in = np.where(labs == cl)[0]
        idx_out = np.where(labs != cl)[0]
        if idx_in.size < 3 or idx_out.size < 3:
            top_degs[str(cl)] = []
            all_sig_degs[str(cl)] = []
            continue
        mu_in = X[idx_in].mean(axis=0)
        mu_out = X[idx_out].mean(axis=0)
        pct_in = (X[idx_in] > 0).mean(axis=0)
        pct_out = (X[idx_out] > 0).mean(axis=0)
        log2fc = np.log2((mu_in + 1e-9) / (mu_out + 1e-9))
        pvals = np.ones(X.shape[1], dtype=float)
        try:
            for j in np.where(base_mask)[0]:
                try:
                    stat = mannwhitneyu(X[idx_in, j], X[idx_out, j], alternative='two-sided', method='auto')
                    pvals[j] = float(stat.pvalue)
                except TypeError:
                    _, pv = mannwhitneyu(X[idx_in, j], X[idx_out, j], alternative='two-sided')
                    pvals[j] = float(pv)
        except Exception:
            pass
        qvals = bh_fdr(pvals)
        sig = (qvals < 0.05) & (pct_in >= 0.2) & ((pct_in - pct_out) >= 0.1) & (log2fc >= 0.25) & base_mask
        sig_idx = np.where(sig)[0]
        if sig_idx.size == 0:
            # fallback: top by log2fc among included
            cand = np.where(base_mask)[0]
            order = cand[np.argsort(-log2fc[cand])]
            genes = var_names[order][:20].tolist()
            top_degs[str(cl)] = genes
            all_sig_degs[str(cl)] = []
        else:
            order = sig_idx[np.argsort(-log2fc[sig_idx])]
            genes = var_names[order][:20].tolist()
            top_degs[str(cl)] = genes
            all_sig_degs[str(cl)] = var_names[sig_idx].tolist()
    return top_degs, all_sig_degs

def compute_set_activities(ad_all, labs_all, S, set_meta):
    # Prefer model-provided set activities; else compute from expression
    n = ad_all.n_obs
    use_model = False
    set_scores = None
    if os.path.exists(CONFIG['set_activity_train']) and os.path.exists(CONFIG['set_activity_val']) and os.path.exists(CONFIG['set_activity_test']):
        splits = ad_all.obs['split'].astype(str).values if 'split' in ad_all.obs.columns else np.array(['all'] * n)
        mask_tr = (splits == 'train')
        mask_va = (splits == 'val')
        mask_te = (splits == 'test')
        A_tr = np.load(CONFIG['set_activity_train'])
        A_va = np.load(CONFIG['set_activity_val'])
        A_te = np.load(CONFIG['set_activity_test'])
        n_sets = A_tr.shape[1]
        set_scores = np.zeros((n, n_sets), dtype=float)
        if A_tr.shape[0] == mask_tr.sum():
            set_scores[mask_tr, :] = A_tr
        if A_va.shape[0] == mask_va.sum():
            set_scores[mask_va, :] = A_va
        if A_te.shape[0] == mask_te.sum():
            set_scores[mask_te, :] = A_te
        use_model = True
    if not use_model:
        # compute from expression using S and all prior-in-vocab genes
        if S is None or set_meta is None:
            return None
        X = ad_all.layers['log1p'] if 'log1p' in ad_all.layers else ad_all.X
        if sp.issparse(X):
            X = X.tocsr()
        else:
            X = sp.csr_matrix(np.asarray(X))
        # Map adata genes to S columns using gene symbols
        # Assume S columns order matches gene_vocab symbols saved; we cannot remap here robustly without gene_vocab index, handled upstream
        # We will align by overlapping genes via gene_vocab
        try:
            gv = pd.read_csv(CONFIG['gene_vocab'])
            symbol_to_idx = {g: i for i, g in enumerate(gv['symbol'].astype(str).values)}
            ad_syms = ad_all.var_names.to_numpy().astype(str)
            mapped = np.array([symbol_to_idx.get(g, -1) for g in ad_syms], dtype=int)
            valid = mapped >= 0
            cols = mapped[valid]
            if cols.size == 0:
                return None
            S_sub = S[:, cols].tocsr()
            row_sums = np.array(S_sub.sum(axis=1)).ravel()
            row_sums[row_sums == 0] = 1.0
            inv = sp.diags(1.0 / row_sums)
            S_sub = inv.dot(S_sub)
            X_sub = X[:, np.where(valid)[0]]
            set_scores = X_sub.dot(S_sub.T).toarray()
        except Exception:
            return None
    labs = np.array(labs_all, dtype=str)
    uniq = np.unique(labs)
    set_results = {}
    for cl in uniq:
        idx_in = np.where(labs == cl)[0]
        idx_out = np.where(labs != cl)[0]
        if idx_in.size < 3 or idx_out.size < 3:
            set_results[str(cl)] = []
            continue
        in_means = set_scores[idx_in].mean(axis=0)
        out_means = set_scores[idx_out].mean(axis=0)
        diff = np.asarray(in_means - out_means).ravel()
        pos = np.where(diff > 0)[0]
        if pos.size == 0:
            set_results[str(cl)] = []
            continue
        order = pos[np.argsort(-diff[pos])]
        # significance/AUC
        p = np.ones(set_scores.shape[1], dtype=float)
        aucs = np.full(set_scores.shape[1], 0.5, dtype=float)
        for j in order[:min(200, order.size)]:
            try:
                stat = mannwhitneyu(set_scores[idx_in, j], set_scores[idx_out, j], alternative='two-sided', method='auto')
                p[j] = float(stat.pvalue)
            except TypeError:
                _, pv = mannwhitneyu(set_scores[idx_in, j], set_scores[idx_out, j], alternative='two-sided')
                p[j] = float(pv)
            try:
                u_lr = mannwhitneyu(set_scores[idx_in, j], set_scores[idx_out, j], alternative='less').statistic
                aucs[j] = float(u_lr) / float(len(idx_in) * len(idx_out))
            except Exception:
                a = set_scores[idx_in, j]
                b = set_scores[idx_out, j]
                rs_in = a if a.size * b.size <= 50000 else np.random.choice(a, size=min(a.size, 200), replace=False)
                rs_out = b if a.size * b.size <= 50000 else np.random.choice(b, size=min(b.size, 200), replace=False)
                aucs[j] = float((rs_in[:, None] > rs_out[None, :]).mean())
        q = bh_fdr(p)
        enriched = np.where((diff > 0) & (q < 0.05) & (aucs >= 0.6))[0]
        if enriched.size == 0:
            set_results[str(cl)] = []
            continue
        # sort by effect then q
        ord2 = enriched[np.lexsort((q[enriched], -diff[enriched]))]
        top_idx = ord2[:10]
        rows = []
        for j in top_idx:
            sid = int(set_meta.iloc[j].get('set_id', j)) if 'set_id' in set_meta.columns else int(j)
            name = str(set_meta.iloc[j].get('name', f'set_{j}'))
            src = str(set_meta.iloc[j].get('source', 'NA'))
            cat = str(set_meta.iloc[j].get('category', 'NA'))
            fdr = float(max(min(q[j], 1.0), 1e-300))
            eff = float(diff[j])
            auc = float(aucs[j])
            rows.append({'set_id': sid, 'name': name, 'source': src, 'category': cat, 'fdr': fdr, 'effect_size': eff, 'auc': auc})
        set_results[str(cl)] = rows
    return set_results

def marker_concordance(all_sig_degs, S, set_meta, ad_all):
    if S is None or set_meta is None:
        return {k: [] for k in all_sig_degs.keys()}
    # Build set memberships by symbols present in adata
    try:
        gv = pd.read_csv(CONFIG['gene_vocab'])
        symbol_to_idx = {g: i for i, g in enumerate(gv['symbol'].astype(str).values)}
        ad_syms = ad_all.var_names.to_numpy().astype(str)
        mapped = np.array([symbol_to_idx.get(g, -1) for g in ad_syms], dtype=int)
        valid = mapped >= 0
        cols = mapped[valid]
        if cols.size == 0:
            return {k: [] for k in all_sig_degs.keys()}
        S_sub = S[:, cols].tocsr()
        ad_syms_present = ad_syms[valid]
        set_members = []
        for i in range(S_sub.shape[0]):
            row = S_sub.getrow(i)
            genes_i = set(ad_syms_present[row.indices].tolist())
            set_members.append(genes_i)
        # marker indices
        mk_mask = np.array([(str(src).lower() == 'cellmarker') or (str(cat).lower() == 'marker')
                            for src, cat in zip(set_meta.get('source', ['']*S_sub.shape[0]),
                                                set_meta.get('category', ['']*S_sub.shape[0]))])
        mk_idx = np.where(mk_mask)[0].tolist()
        out = {}
        for cl, genes in all_sig_degs.items():
            gset = set(genes)
            rows = []
            if len(gset) > 0:
                for j in mk_idx:
                    inter = gset & set_members[j]
                    union = gset | set_members[j]
                    if len(inter) == 0:
                        continue
                    jac = (len(inter) / float(len(union))) if len(union) > 0 else 0.0
                    rows.append({
                        'set_id': int(set_meta.iloc[j].get('set_id', j)) if 'set_id' in set_meta.columns else int(j),
                        'name': str(set_meta.iloc[j].get('name', f'set_{j}')),
                        'jaccard': float(jac),
                        'overlap_genes': sorted(list(inter))
                    })
            rows = sorted(rows, key=lambda x: (-x['jaccard'], x['name']))[:5]
            out[cl] = rows
        return out
    except Exception:
        return {k: [] for k in all_sig_degs.keys()}

def main():
    ensure_dirs()
    # Early placeholders to ensure artifact presence
    if not os.path.exists(CONFIG['cluster_assignments']):
        with open(CONFIG['cluster_assignments'], 'w') as f:
            f.write('cell_id,predicted_cluster,split\n')
    # Load AnnData
    if ad is None or (not os.path.exists(CONFIG['input_h5ad'])):
        # Minimal outputs if no data
        cell_ids = np.array(['cell_0'])
        splits = np.array(['all'])
        pred = np.array(['0'])
        pd.DataFrame({'cell_id': cell_ids, 'predicted_cluster': pred, 'split': splits}).to_csv(CONFIG['cluster_assignments'], index=False)
        with open(CONFIG['cluster_metrics'], 'w') as f:
            json.dump({'ari': None}, f, indent=2)
        pd.DataFrame([{'cluster': '0', 'size': 1, 'domains': '', 'protocols': '', 'top_sets': '', 'top_degs': ''}]).to_csv(CONFIG['cluster_summary_csv'], index=False)
        with open(CONFIG['cluster_summary_json'], 'w') as f:
            json.dump({'0': {'size': 1}}, f, indent=2)
        write_dummy_png(CONFIG['umap_plot'])
        return

    ad_all = ad.read_h5ad(CONFIG['input_h5ad'])
    n = ad_all.n_obs
    cell_ids = ad_all.obs_names.to_numpy().astype(str)
    splits = ad_all.obs['split'].astype(str).values if 'split' in ad_all.obs.columns else np.array(['all'] * n)
    domains = ad_all.obs['domain'].astype(str).values if 'domain' in ad_all.obs.columns else np.array(['NA'] * n)
    protocols = ad_all.obs['protocol'].astype(str).values if 'protocol' in ad_all.obs.columns else np.array(['NA'] * n)

    # Load embeddings and standardize (anchor-based)
    emb = load_embeddings(ad_all)
    mask_tr = (splits == 'train')
    mask_va = (splits == 'val')
    mask_te = (splits == 'test')
    mask_anchor = mask_tr | mask_va
    # Build variants and metrics
    variants = build_variants(emb, splits, domains)
    metrics_to_try = ['cosine', 'euclidean']

    # k grid adaptive + include model k_opt neighborhood if present
    n_sel = int(np.sum(mask_anchor)) if np.any(mask_anchor) else emb.shape[0]
    base_max = int(min(80, max(2, round(3 * math.sqrt(max(2, n_sel))))))
    k_grid = list(range(2, base_max + 1))
    # include k_opt window if available
    k_opts = []
    for path in [CONFIG['model_performance'], CONFIG['train_log']]:
        if os.path.exists(path):
            try:
                perf = json.load(open(path, 'r'))
                if isinstance(perf, dict):
                    for kkey in ['k_opt', 'best_k', 'n_clusters']:
                        if kkey in perf and isinstance(perf[kkey], (int, float)):
                            k_opts.append(int(perf[kkey]))
            except Exception:
                pass
    for ko in k_opts:
        for d in [-2, -1, 0, 1, 2]:
            kd = int(max(2, min(base_max, ko + d)))
            if kd not in k_grid:
                k_grid.append(kd)
    k_grid = sorted(set(k_grid))

    # selection over variants/metrics with stability and ASW-batch penalty
    best_overall = None
    selection_history = []
    seeds = list(range(10))
    for vname, v in variants.items():
        for metric in metrics_to_try:
            X_use = v['X_cos'] if metric == 'cosine' else v['X_euc']
            Xa = X_use[mask_anchor] if np.any(mask_anchor) else X_use
            dom_a = domains[mask_anchor] if np.any(mask_anchor) else domains
            if Xa.shape[0] < 3:
                continue
            best, hist = evaluate_kmeans_stability(Xa, dom_a, metric, k_grid, seeds, alpha=0.2)
            for r in hist:
                r2 = r.copy()
                r2['variant'] = vname
                selection_history.append(r2)
            if best is None:
                continue
            rec = best.copy()
            rec['variant'] = vname
            if (best_overall is None) or (rec['objective'] > best_overall['objective']) or (math.isclose(rec['objective'], best_overall['objective']) and rec['stability'] > best_overall['stability'])):
                best_overall = rec

    # Fallback if selection failed
    if best_overall is None:
        chosen_variant = 'global'
        chosen_metric = 'cosine'
        X_use = variants[chosen_variant]['X_cos']
        Xa = X_use[mask_anchor] if np.any(mask_anchor) else X_use
        k_chosen = int(min(10, max(2, Xa.shape[0] // 50 or 2)))
        labs_anchor = kmeans_labels(Xa, k_chosen, seed=42)
    else:
        chosen_variant = best_overall['variant']
        chosen_metric = best_overall['metric']
        X_use = variants[chosen_variant]['X_cos'] if chosen_metric == 'cosine' else variants[chosen_variant]['X_euc']
        Xa = X_use[mask_anchor] if np.any(mask_anchor) else X_use
        k_chosen = int(best_overall['k'])
        labs_anchor = kmeans_labels(Xa, k_chosen, seed=42)

    # Recursive splitting of low-quality anchor clusters
    if Xa.shape[0] >= 10 and len(np.unique(labs_anchor)) >= 1:
        labs_anchor = recursive_split_anchors(Xa, labs_anchor, metric=chosen_metric, max_iter=3, sil_threshold=0.1, min_gain=0.01)

    # Propagate to all cells via soft kNN with k/T tuned on anchors
    X_anchor = Xa
    X_all = X_use
    if np.any(~mask_anchor):
        k_trans, temp = choose_k_and_temperature_for_propagation(X_anchor, labs_anchor, metric=chosen_metric, k_grid=(5,10,15,20,30,40), T_grid=(0.25,0.5,1.0,2.0))
    else:
        k_trans, temp = 15, 1.0
    y_all = np.empty(n, dtype=object)
    if np.any(mask_anchor):
        y_all[mask_anchor] = labs_anchor
    else:
        # if no anchors, fit kmeans on all
        y_all[:] = kmeans_labels(X_all, max(2, min(10, X_all.shape[0] // 100 or 2)), seed=42)
    if np.any(~mask_anchor):
        X_query = X_all[~mask_anchor]
        y_all[~mask_anchor] = soft_label_propagation(X_anchor, labs_anchor, X_query, metric=chosen_metric, k=k_trans, temperature=temp)

    # Safe merging of very small clusters
    y_all = merge_small_clusters_safe(X_all, y_all, mask_anchor=mask_anchor, metric=chosen_metric)

    # Write cluster assignments
    pred_clusters = np.array(y_all, dtype=str)
    df_assign = pd.DataFrame({'cell_id': cell_ids, 'predicted_cluster': pred_clusters, 'split': splits})
    df_assign.to_csv(CONFIG['cluster_assignments'], index=False)

    # Metrics: ARI overall and per split (post hoc, using obs['cell_type'] if present)
    metrics = {
        'ari': None,
        'ari_train': None,
        'ari_val': None,
        'ari_test': None,
        'selection': {
            'variant': chosen_variant,
            'metric': chosen_metric,
            'algorithm': 'kmeans',
            'params': {'k': int(k_chosen)},
            'k_transfer': int(k_trans),
            'temperature': float(temp),
            'n_clusters_final': int(len(np.unique(pred_clusters))),
            'random_state': 42
        },
        'selection_history': selection_history
    }
    if 'cell_type' in ad_all.obs.columns:
        y_true = ad_all.obs['cell_type'].astype(str).values
        if len(np.unique(y_true)) > 1 and len(np.unique(pred_clusters)) > 1:
            metrics['ari'] = float(adjusted_rand_score(y_true, pred_clusters))
        for sp_name, msk in [('train', mask_tr), ('val', mask_va), ('test', mask_te)]:
            if np.sum(msk) > 1 and len(np.unique(pred_clusters[msk])) > 1 and len(np.unique(y_true[msk])) > 1:
                metrics[f'ari_{sp_name}'] = float(adjusted_rand_score(y_true[msk], pred_clusters[msk]))
    # Log ASW-batch for chosen embedding on anchors
    try:
        Xa = X_all[mask_anchor] if np.any(mask_anchor) else X_all
        dom_a = domains[mask_anchor] if np.any(mask_anchor) else domains
        metrics['asw_batch_anchor'] = asw_batch(Xa, dom_a, metric=chosen_metric)
        metrics['silhouette_anchor'] = fast_silhouette(Xa, pred_clusters[mask_anchor] if np.any(mask_anchor) else pred_clusters, metric=chosen_metric)
    except Exception:
        pass

    with open(CONFIG['cluster_metrics'], 'w') as f:
        json.dump(metrics, f, indent=2)

    # Summary: DEGs and set activities
    S, set_meta, gene_vocab = load_prior_artifacts()
    # Gene include mask: HVGs union prior-in-vocab genes
    genes_include_mask = None
    try:
        hv = ad_all.var['highly_variable'].astype(bool).values if 'highly_variable' in ad_all.var.columns else np.zeros(ad_all.n_vars, dtype=bool)
        if gene_vocab is not None and 'symbol' in gene_vocab.columns:
            syms = ad_all.var_names.to_numpy().astype(str)
            in_prior = syms.astype(object).isin(set(gene_vocab['symbol'].astype(str).values))
        else:
            in_prior = np.zeros(ad_all.n_vars, dtype=bool)
        genes_include_mask = hv | in_prior
    except Exception:
        genes_include_mask = None

    top_degs_per_cluster, all_sig_degs = compute_deg(ad_all, pred_clusters, genes_include_mask, gene_vocab if gene_vocab is not None else pd.DataFrame())
    set_results = compute_set_activities(ad_all, pred_clusters, S, set_meta)

    # Build marker concordance using all significant DEGs
    marker_overlap = marker_concordance(all_sig_degs, S, set_meta, ad_all)

    # Build summary dict and CSV
    clusters = np.unique(pred_clusters)
    summary = {}
    csv_rows = []
    for c in clusters:
        idx_in = np.where(pred_clusters == c)[0]
        dom_counts = pd.Series(domains[idx_in]).value_counts().to_dict()
        prot_counts = pd.Series(protocols[idx_in]).value_counts().to_dict()
        top_sets = set_results.get(str(c), []) if isinstance(set_results, dict) else []
        top_degs = top_degs_per_cluster.get(str(c), [])
        mean_latent = X_all[idx_in].mean(axis=0).astype(float).tolist()
        summary[str(c)] = {
            'size': int(idx_in.size),
            'domain_counts': dom_counts,
            'protocol_counts': prot_counts,
            'top_sets': top_sets,
            'top_degs': top_degs,
            'marker_overlap': marker_overlap.get(str(c), []),
            'mean_latent': mean_latent
        }
        top_sets_str = ';'.join([f"{ts['name']}(FDR={max(min(ts['fdr'],1.0),1e-300):.3g})" for ts in top_sets]) if len(top_sets) > 0 else ''
        dom_str = ';'.join([f"{k}:{v}" for k, v in sorted(dom_counts.items(), key=lambda x: (-x[1], x[0]))])
        prot_str = ';'.join([f"{k}:{v}" for k, v in sorted(prot_counts.items(), key=lambda x: (-x[1], x[0]))])
        csv_rows.append({
            'cluster': str(c),
            'size': int(idx_in.size),
            'domains': dom_str,
            'protocols': prot_str,
            'top_sets': top_sets_str,
            'top_degs': ';'.join(top_degs)
        })

    with open(CONFIG['cluster_summary_json'], 'w') as f:
        json.dump(summary, f, indent=2)
    pd.DataFrame(csv_rows).to_csv(CONFIG['cluster_summary_csv'], index=False)

    # UMAP plot (must save PNG)
    try:
        import umap
        if plt is None:
            raise RuntimeError("matplotlib unavailable")
        metric_use = chosen_metric if chosen_metric in ('euclidean', 'cosine', 'manhattan', 'chebyshev', 'minkowski') else 'euclidean'
        reducer = umap.UMAP(n_neighbors=30, min_dist=0.3, metric=metric_use, random_state=42)
        coords = reducer.fit_transform(X_all)
        plt.figure(figsize=(6, 5))
        clabs = np.array(pred_clusters).astype(str)
        uniq = np.unique(clabs)
        cmap = plt.get_cmap('tab20')
        color_map = {cl: cmap(i % 20) for i, cl in enumerate(uniq)}
        colors = [color_map[c] for c in clabs]
        plt.scatter(coords[:, 0], coords[:, 1], c=colors, s=5, linewidths=0, alpha=0.9)
        plt.axis('off')
        plt.title('UMAP of latent - Clusters')
        plt.tight_layout()
        plt.savefig(CONFIG['umap_plot'], dpi=150)
        plt.close()
    except Exception:
        write_dummy_png(CONFIG['umap_plot'])

if __name__ == "__main__":
    main()
