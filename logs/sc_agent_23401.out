PREPROCESS_DIR = "/home/mcb/users/ekourb/singlecell_Agent/runsv3/results/intermediate_output/step_0"
PREPROCESS_METADATA = os.path.join(PREPROCESS_DIR, "preprocess_metadata.json")
PREPROCESS_TRAIN = os.path.join(PREPROCESS_DIR, "preprocess_train_mod1.h5ad")
PREPROCESS_VAL = os.path.join(PREPROCESS_DIR, "preprocess_val_mod1.h5ad")
PREPROCESS_TEST = os.path.join(PREPROCESS_DIR, "preprocess_test_mod1.h5ad")

# Additional fixed outputs for alignment and reproducibility
PREPROCESS_COMBINED = os.path.join(PREPROCESS_DIR, "anndata_processed_mod1.h5ad")
GENE_LIST_PATH = os.path.join(PREPROCESS_DIR, "gene_list.txt")
INDEX_TRAIN = os.path.join(PREPROCESS_DIR, "index_train.npy")
INDEX_VAL = os.path.join(PREPROCESS_DIR, "index_val.npy")
INDEX_TEST = os.path.join(PREPROCESS_DIR, "index_test.npy")
CELL_IDS_TRAIN = os.path.join(PREPROCESS_DIR, "cell_ids_train.txt")
CELL_IDS_VAL = os.path.join(PREPROCESS_DIR, "cell_ids_val.txt")
CELL_IDS_TEST = os.path.join(PREPROCESS_DIR, "cell_ids_test.txt")
REINDEXED_SET_INCIDENCE = os.path.join(PREPROCESS_DIR, "set_incidence_reindexed.npz")
REINDEXED_GENE_ADJ = os.path.join(PREPROCESS_DIR, "gene_gene_adj_reindexed.npz")
SET_META_COPY = os.path.join(PREPROCESS_DIR, "set_meta.csv")
GENE_WEIGHTS_ALIGNED = os.path.join(PREPROCESS_DIR, "gene_prior_weights_aligned.csv")
