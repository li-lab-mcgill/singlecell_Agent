import json
from typing import Dict, List, Tuple, Set
import numpy as np
import pandas as pd
import anndata as ad
from scipy import sparse
from scipy.sparse import csr_matrix, save_npz, load_npz

# Fixed paths (do not change)
INPUT_MOD1 = "/home/mcb/users/ekourb/singlecell_Agent/Datasets/RNA_count.h5ad"
PRIOR_OUTPUT_DIR = "/home/mcb/users/ekourb/singlecell_Agent/runsv3/results/intermediate_output/step_0/prior"
# Mirror to canonical priors dir for downstream consumption
PRIOR_MIRROR_DIR = "/home/mcb/users/ekourb/singlecell_Agent/runsv3/priors"
# Derived downstream prior dir for next steps (to satisfy stages expecting step_1/prior and step_2/prior)
